<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The WinUI application needs the Windows App SDK, which ships only as a NuGet package. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
