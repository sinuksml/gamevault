<Project>
  <!--
    Single source of truth for the Windows application version.

    The version used to be repeated in GameVault.Windows.csproj, installer.iss,
    build-release.ps1 and ARCHITECTURE.md, so a release could easily ship with
    three different numbers. build-release.ps1 now reads this value and passes it
    to Inno Setup, and the csproj inherits it.
  -->
  <PropertyGroup>
    <GameVaultVersion>2.5.1</GameVaultVersion>
    <Version>$(GameVaultVersion)</Version>
  </PropertyGroup>
</Project>
