<ContentDialog
    x:Class="SinuGameVault.Dialogs.ItemEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Style="{ThemeResource DefaultContentDialogStyle}"
    Title="Edit title"
    PrimaryButtonText="Save changes"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="Save_Click">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">760</x:Double>
    </ContentDialog.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Width="640" Spacing="14" Margin="0,0,16,0">
            <TextBlock x:Name="Description" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                       Text="Changes are saved to the same Drive-synced record the web and TV apps use." />
            <InfoBar x:Name="Problem" Severity="Error" IsClosable="False" IsOpen="False" />

            <TextBox x:Name="NameBox" Header="Title" />

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <ComboBox x:Name="StatusBox" Header="Status" IsEditable="True" HorizontalAlignment="Stretch" />
                <TextBox x:Name="PlatformBox" Grid.Column="1" Header="Platform or service" />
            </Grid>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <CalendarDatePicker x:Name="StartDateBox" Header="Release date" HorizontalAlignment="Stretch" DateFormat="{}{day.integer} {month.abbreviated} {year.full}" />
                <CalendarDatePicker x:Name="EndDateBox" Grid.Column="1" Header="Return date" HorizontalAlignment="Stretch" DateFormat="{}{day.integer} {month.abbreviated} {year.full}" />
            </Grid>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBox x:Name="VendorBox" Header="Vendor or provider" />
                <NumberBox x:Name="CostBox" Grid.Column="1" Header="Cost (₹)" Minimum="0" SpinButtonPlacementMode="Hidden" />
            </Grid>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <NumberBox x:Name="RatingBox" Header="Your rating (0–10)" Minimum="0" Maximum="10" SpinButtonPlacementMode="Inline" />
                <TextBox x:Name="GenreBox" Grid.Column="1" Header="Genre" />
            </Grid>

            <TextBox x:Name="ImageBox" Header="Cover image URL" />
            <TextBox x:Name="OverviewBox" Header="Plot or summary" Height="110" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" />
            <TextBox x:Name="NoteBox" Header="Notes" Height="80" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
