<ContentDialog
    x:Class="SinuGameVault.Dialogs.CatalogSearchDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SinuGameVault"
    xmlns:dialogs="using:SinuGameVault.Dialogs"
    Style="{ThemeResource DefaultContentDialogStyle}"
    Title="Find a title"
    PrimaryButtonText="Add selected"
    SecondaryButtonText="Enter manually"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False"
    PrimaryButtonClick="Add_Click"
    SecondaryButtonClick="Manual_Click">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">820</x:Double>
    </ContentDialog.Resources>

    <Grid Width="700" Height="480" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <AutoSuggestBox x:Name="QueryBox" PlaceholderText="Type a title and press Enter" QueryIcon="Find" QuerySubmitted="Query_Submitted" />

        <ListView x:Name="Results" Grid.Row="1" SelectionMode="Single"
                  SelectionChanged="Results_SelectionChanged" DoubleTapped="Results_DoubleTapped">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="dialogs:SearchResultRow">
                    <Grid ColumnSpacing="14" Padding="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="56" Height="72" CornerRadius="4" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                            <Image Stretch="UniformToFill" local:Art.DecodeWidth="112" local:Art.Url="{x:Bind Image}" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionSecondaryStyle}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{x:Bind Rating}" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="1" x:Name="Busy" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <ProgressRing IsActive="True" />
            <TextBlock Text="Searching…" Style="{StaticResource SecondaryTextStyle}" />
        </StackPanel>

        <TextBlock x:Name="StatusText" Grid.Row="2" Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap"
                   Text="Search the live catalog, or enter the details yourself." />
    </Grid>
</ContentDialog>
