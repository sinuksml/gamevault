<ContentDialog
    x:Class="SinuGameVault.Dialogs.SubscriptionsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dialogs="using:SinuGameVault.Dialogs"
    Style="{ThemeResource DefaultContentDialogStyle}"
    Title="Gaming subscriptions"
    PrimaryButtonText="Apply changes"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="Apply_Click">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">880</x:Double>
    </ContentDialog.Resources>

    <Grid Width="760" Height="460" ColumnSpacing="20" RowSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.ColumnSpan="2" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                   Text="GeForce NOW, Game Pass and other services with their renewal dates. Subscription games link to one of these." />

        <ListView x:Name="List" Grid.Row="1" SelectionMode="Single" SelectionChanged="List_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="dialogs:SubscriptionRow">
                    <StackPanel Padding="0,8" Spacing="2">
                        <TextBlock Text="{x:Bind Service}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionSecondaryStyle}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardStyle}" Padding="16">
            <StackPanel Spacing="10">
                <InfoBar x:Name="Problem" Severity="Error" IsClosable="False" IsOpen="False" />
                <TextBox x:Name="ServiceBox" Header="Service" PlaceholderText="GeForce NOW" />
                <CalendarDatePicker x:Name="StartBox" Header="Start date" HorizontalAlignment="Stretch" />
                <CalendarDatePicker x:Name="EndBox" Header="Renewal or end date" HorizontalAlignment="Stretch" />
                <NumberBox x:Name="MonthlyBox" Header="Monthly cost (₹)" Minimum="0" SpinButtonPlacementMode="Hidden" />
                <NumberBox x:Name="TotalBox" Header="Total paid (₹)" Minimum="0" SpinButtonPlacementMode="Hidden" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                    <Button Content="Save" Style="{StaticResource AccentButtonStyle}" Click="Save_Click" />
                    <Button Content="New" Click="New_Click" />
                    <Button Content="Remove" Click="Remove_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</ContentDialog>
