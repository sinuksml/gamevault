<Page
    x:Class="SinuGameVault.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SinuGameVault"
    xmlns:controls="using:SinuGameVault.Controls"
    xmlns:models="using:SinuGameVault.Models"
    SizeChanged="Page_SizeChanged">

    <Page.Resources>
        <!-- A card you can click: the artwork card inside a borderless button. -->
        <DataTemplate x:Key="ShelfCardTemplate" x:DataType="models:LibraryRow">
            <Button Padding="6" Background="Transparent" BorderThickness="0" VerticalAlignment="Top"
                    Tag="{x:Bind}" Click="ShelfCard_Click" AutomationProperties.Name="{x:Bind Name}">
                <controls:TitleCard Row="{x:Bind}" ShowCategory="True" Compact="True" />
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="DueTemplate" x:DataType="models:DueDateRow">
            <Grid ColumnSpacing="14" Padding="0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="44" Height="44" CornerRadius="6">
                    <Border Background="{x:Bind local:Ui.Brush(PlaceholderColor)}">
                        <TextBlock Text="{x:Bind Initials}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="13" FontWeight="SemiBold" />
                    </Border>
                    <Image Stretch="UniformToFill" local:Art.DecodeWidth="88" local:Art.Url="{x:Bind Image}" />
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind local:Ui.JoinDot(Kind, VendorLine)}" Style="{StaticResource CaptionSecondaryStyle}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="1">
                    <TextBlock Text="{x:Bind Countdown}" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{x:Bind local:Ui.DueBrush(DaysLeft)}" />
                    <TextBlock Text="{x:Bind DueText}" Style="{StaticResource CaptionSecondaryStyle}" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="28">

            <StackPanel>
                <TextBlock x:Name="Greeting" Text="Welcome back" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="Summary" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Figures -->
            <Grid x:Name="Stats" ColumnSpacing="12" RowSpacing="12" />

            <!-- Shelves -->
            <StackPanel x:Name="PlayingShelf" Spacing="8">
                <Grid>
                    <TextBlock Text="Continue playing" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                    <HyperlinkButton Content="All games" HorizontalAlignment="Right" Tag="Games:playing" Click="Shortcut_Click" />
                </Grid>
                <ItemsRepeater x:Name="PlayingRepeater" Margin="-6,0,0,0" ItemTemplate="{StaticResource ShelfCardTemplate}">
                    <ItemsRepeater.Layout><UniformGridLayout MinColumnSpacing="4" MinRowSpacing="8" /></ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>

            <StackPanel x:Name="WatchingShelf" Spacing="8">
                <Grid>
                    <TextBlock Text="Continue watching" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                    <HyperlinkButton Content="All movies" HorizontalAlignment="Right" Tag="Movies:watching" Click="Shortcut_Click" />
                </Grid>
                <ItemsRepeater x:Name="WatchingRepeater" Margin="-6,0,0,0" ItemTemplate="{StaticResource ShelfCardTemplate}">
                    <ItemsRepeater.Layout><UniformGridLayout MinColumnSpacing="4" MinRowSpacing="8" /></ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>

            <Border x:Name="Welcome" Style="{StaticResource CardStyle}" Visibility="Collapsed" Padding="28">
                <StackPanel Spacing="10">
                    <TextBlock Text="Your library is ready" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                               Text="Add a game, movie or show to begin, or sign in to Google Drive in Settings to bring back a library you already have." />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                        <Button Content="Add a game" Style="{StaticResource AccentButtonStyle}" Tag="Games:queue" Click="Shortcut_Click" />
                        <Button Content="Open Settings" Tag="Settings" Click="Shortcut_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Money and dates -->
            <Grid x:Name="Panels" ColumnSpacing="20" RowSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="DuePanel" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Due dates" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock x:Name="DueSubtitle" Style="{StaticResource CaptionSecondaryStyle}" />
                        <ItemsRepeater x:Name="DueRepeater" ItemTemplate="{StaticResource DueTemplate}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border x:Name="UpcomingPanel" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Coming up" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock x:Name="UpcomingSubtitle" Style="{StaticResource CaptionSecondaryStyle}" />
                        <StackPanel x:Name="UpcomingList" Margin="-8,6,-8,0" />
                    </StackPanel>
                </Border>

                <Border x:Name="SpendPanel" Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Where the money went" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock x:Name="SpendHint" Style="{StaticResource CaptionSecondaryStyle}" />
                        <Grid ColumnSpacing="24" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="176" Height="176" VerticalAlignment="Top">
                                <Canvas x:Name="Donut" Width="176" Height="176" />
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="DonutTotal" Text="₹0" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="total spent" Style="{StaticResource CaptionSecondaryStyle}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                            <StackPanel x:Name="SpendLegend" Grid.Column="1" Spacing="2" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="MonthlyPanel" Grid.Row="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Spending by month" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Last 12 months. Each bar is split by vendor; hover for the amounts." Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap" />
                        <Grid x:Name="MonthlyChart" Height="170" Margin="0,12,0,0" ColumnSpacing="6" />
                    </StackPanel>
                </Border>

                <Border x:Name="PetrolPanel" Grid.Row="1" Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="6">
                        <Grid>
                            <TextBlock Text="Petrol" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                            <HyperlinkButton Content="Log a refill" HorizontalAlignment="Right" Tag="Petrol" Click="Shortcut_Click" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock x:Name="PetrolDays" Text="--" Style="{StaticResource FigureStyle}" />
                            <TextBlock x:Name="PetrolCaption" Text="no refills logged yet" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Bottom" Margin="0,0,0,7" />
                        </StackPanel>
                        <TextBlock x:Name="PetrolHint" Style="{StaticResource CaptionSecondaryStyle}" />
                        <Grid x:Name="PetrolChart" Height="112" Margin="0,8,0,0" ColumnSpacing="6" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
