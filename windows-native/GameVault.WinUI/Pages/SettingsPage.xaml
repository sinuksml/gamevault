<Page
    x:Class="SinuGameVault.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Page.Resources>
        <Style x:Key="SettingExpander" TargetType="Expander">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="GroupLabel" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="0,16,0,2" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="6" MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" />

            <!-- Appearance -->
            <TextBlock Text="Appearance" Style="{StaticResource GroupLabel}" />
            <Border Style="{StaticResource CardStyle}" Padding="16,12">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE790;" FontSize="18" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="App theme" />
                        <TextBlock Text="Choose light or dark, or follow Windows." Style="{StaticResource CaptionSecondaryStyle}" />
                    </StackPanel>
                    <ComboBox x:Name="ThemeBox" Grid.Column="2" MinWidth="190" VerticalAlignment="Center" SelectionChanged="Theme_Changed">
                        <ComboBoxItem Content="Use system setting" Tag="system" />
                        <ComboBoxItem Content="Light" Tag="light" />
                        <ComboBoxItem Content="Dark" Tag="dark" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- Sync -->
            <TextBlock Text="Sync and catalogs" Style="{StaticResource GroupLabel}" />
            <Expander Style="{StaticResource SettingExpander}">
                <Expander.Header>
                    <Grid ColumnSpacing="16" Padding="0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE753;" FontSize="18" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Google Drive" />
                            <TextBlock x:Name="DriveSummary" Text="Not connected" Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Expander.Header>
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                               Text="The whole library is stored as game-vault-backup.json in your Google Drive and syncs after each change, shared with the web and TV apps. To connect, create a Desktop OAuth client in Google Cloud Console with the Drive API enabled and paste its Client ID here. After reinstalling, sign in with the same account to bring the library back." />
                    <TextBox x:Name="DriveClientId" Header="Google OAuth Client ID" />
                    <PasswordBox x:Name="DriveClientSecret" Header="Client secret (optional)" />
                    <TextBlock x:Name="DriveBackupInfo" Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="DriveSignInButton" Content="Sign in with Google" Style="{StaticResource AccentButtonStyle}" Click="DriveSignIn_Click" />
                        <Button x:Name="DriveSyncButton" Content="Sync now" Click="DriveSync_Click" />
                        <Button x:Name="DriveDisconnectButton" Content="Disconnect" Click="DriveDisconnect_Click" />
                    </StackPanel>
                </StackPanel>
            </Expander>

            <Expander Style="{StaticResource SettingExpander}">
                <Expander.Header>
                    <Grid ColumnSpacing="16" Padding="0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE721;" FontSize="18" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Catalog keys" />
                            <TextBlock x:Name="CatalogSummary" Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Expander.Header>
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                               Text="RAWG fills game search, Discover and Upcoming. TMDB fills movies and TV. OMDb adds IMDb ratings. Keys are kept in Windows Credential Manager." />
                    <PasswordBox x:Name="RawgKey" Header="RAWG API key (games)" />
                    <PasswordBox x:Name="TmdbKey" Header="TMDB API key (movies and TV)" />
                    <PasswordBox x:Name="OmdbKey" Header="OMDb API key (IMDb ratings)" />
                    <Button Content="Save keys" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" Click="SaveKeys_Click" />
                </StackPanel>
            </Expander>

            <!-- Services -->
            <TextBlock Text="Services" Style="{StaticResource GroupLabel}" />
            <Expander Style="{StaticResource SettingExpander}">
                <Expander.Header>
                    <Grid ColumnSpacing="16" Padding="0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE768;" FontSize="18" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Plex Media Server" />
                            <TextBlock x:Name="PlexSummary" Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Expander.Header>
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                               Text="In Plex Web, open any item, choose Get Info then View XML, and copy the X-Plex-Token value from the address. Paste only the token below and choose Find my server: it asks plex.tv for your own server and fills in its address." />
                    <HyperlinkButton Content="Plex's guide to finding the token" Click="PlexHelp_Click" Padding="0" />
                    <PasswordBox x:Name="PlexToken" Header="X-Plex-Token" />
                    <TextBox x:Name="PlexUrl" Header="Server address" PlaceholderText="http://192.168.1.10:32400" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="PlexDiscoverButton" Content="Find my server" Style="{StaticResource AccentButtonStyle}" Click="PlexDiscover_Click" />
                        <Button Content="Save" Click="PlexSave_Click" />
                    </StackPanel>
                </StackPanel>
            </Expander>

            <Expander Style="{StaticResource SettingExpander}">
                <Expander.Header>
                    <Grid ColumnSpacing="16" Padding="0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE896;" FontSize="18" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="BiglyBT downloads" />
                            <TextBlock x:Name="BiglySummary" Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Expander.Header>
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                               Text="Enter the HTTPS address of your BiglyBT gateway and the Web Remote user name and password. Only the resulting session is stored, in Windows Credential Manager, and only for this PC." />
                    <TextBox x:Name="BiglyEndpoint" Header="Gateway address" PlaceholderText="https://…" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <TextBox x:Name="BiglyUser" Header="User name" />
                        <PasswordBox x:Name="BiglyPassword" Grid.Column="1" Header="Password" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="BiglySignInButton" Content="Sign in" Style="{StaticResource AccentButtonStyle}" Click="BiglySignIn_Click" />
                        <Button Content="Forget session" Click="BiglyForget_Click" />
                    </StackPanel>
                    <ToggleSwitch x:Name="BiglyAutoRemove" Header="When a torrent finishes" OnContent="Remove it from BiglyBT and keep the files" OffContent="Leave it in BiglyBT" Toggled="BiglyAutoRemove_Toggled" />
                </StackPanel>
            </Expander>

            <!-- Data -->
            <TextBlock Text="Your data" Style="{StaticResource GroupLabel}" />
            <Border Style="{StaticResource CardStyle}" Padding="16">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8B7;" FontSize="18" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Backup and recovery" />
                            <TextBlock x:Name="VaultPath" Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                               Text="Every save is checked before it replaces the library file, and a snapshot is kept before imports and edits. Importing replaces the whole library with the chosen backup." />
                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="Export backup" Click="Export_Click" />
                        <Button Grid.Column="1" Content="Import backup…" Click="Import_Click" />
                        <Button Grid.Column="2" Content="Create snapshot" Click="Snapshot_Click" />
                        <Button Grid.Column="3" Content="Restore a snapshot…" Click="Restore_Click" />
                        <Button Grid.Column="4" Content="Open data folder" Click="OpenFolder_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="16,12">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE9D9;" FontSize="18" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Diagnostics" />
                        <TextBlock Text="A report of app state and errors. It never contains passwords, tokens or library titles." Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Export report" VerticalAlignment="Center" Click="Diagnostics_Click" />
                </Grid>
            </Border>

            <!-- About -->
            <TextBlock Text="About" Style="{StaticResource GroupLabel}" />
            <Border Style="{StaticResource CardStyle}" Padding="16">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image Source="ms-appx:///Assets/GameVault.png" Width="36" Height="36" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Sinu Game Vault for Windows" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="VersionText" Style="{StaticResource CaptionSecondaryStyle}" />
                        </StackPanel>
                        <Button x:Name="UpdateButton" Grid.Column="2" Content="Check for updates" VerticalAlignment="Center" Click="Updates_Click" />
                    </Grid>
                    <TextBlock Style="{StaticResource CaptionSecondaryStyle}" TextWrapping="Wrap"
                               Text="Shortcuts: Ctrl+K search  ·  Ctrl+R or F5 sync and refresh  ·  Ctrl+, settings  ·  Alt+Left back" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
