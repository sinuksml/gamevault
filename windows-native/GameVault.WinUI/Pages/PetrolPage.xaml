<Page
    x:Class="SinuGameVault.Pages.PetrolPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SinuGameVault.Models">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="20" MaxWidth="980" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="Petrol" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Honda Activa refills. Only the date is recorded; the gaps are worked out from it." Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
            </StackPanel>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="DAYS SINCE LAST FILL" Style="{StaticResource OverlineStyle}" />
                        <TextBlock x:Name="DaysSince" Text="--" Style="{StaticResource FigureStyle}" />
                        <TextBlock x:Name="LastDate" Text="No refills logged yet" Style="{StaticResource CaptionSecondaryStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="TYPICAL GAP" Style="{StaticResource OverlineStyle}" />
                        <TextBlock x:Name="AverageGap" Text="--" Style="{StaticResource FigureStyle}" />
                        <TextBlock Text="days between refills" Style="{StaticResource CaptionSecondaryStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="TOTAL REFILLS" Style="{StaticResource OverlineStyle}" />
                        <TextBlock x:Name="TotalRefills" Text="0" Style="{StaticResource FigureStyle}" />
                        <TextBlock Text="fills recorded" Style="{StaticResource CaptionSecondaryStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <CalendarDatePicker x:Name="RefillDate" Header="Log a refill" MinWidth="220" DateFormat="{}{day.integer} {month.full} {year.full}" />
                    <Button Content="Save refill" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom" Click="Save_Click" />
                </StackPanel>
            </Border>

            <StackPanel Spacing="8">
                <TextBlock Text="History" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock x:Name="EmptyText" Text="Your refills will be listed here, newest first." Style="{StaticResource SecondaryTextStyle}" />
                <ItemsRepeater x:Name="History">
                    <ItemsRepeater.Layout><StackLayout Spacing="6" /></ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:PetrolRow">
                            <Border Style="{StaticResource CardStyle}" Padding="16,12">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{x:Bind Date}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind Ordinal}" Style="{StaticResource CaptionSecondaryStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="1">
                                        <TextBlock Text="{x:Bind GapValue}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                        <TextBlock Text="{x:Bind GapCaption}" Style="{StaticResource CaptionSecondaryStyle}" HorizontalAlignment="Right" />
                                    </StackPanel>
                                    <Button Grid.Column="2" VerticalAlignment="Center" Tag="{x:Bind}" Click="Delete_Click"
                                            Background="Transparent" BorderThickness="0" Padding="8"
                                            ToolTipService.ToolTip="Delete this refill" AutomationProperties.Name="Delete this refill">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
