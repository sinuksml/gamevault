<Page
    x:Class="SinuGameVault.Pages.DetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SinuGameVault"
    SizeChanged="Page_SizeChanged">

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="36,8,36,48" Spacing="20" MaxWidth="1240" HorizontalAlignment="Stretch">

            <!-- Hero: backdrop with the title over a dark scrim, so the text reads in both themes. -->
            <Grid Height="340" CornerRadius="12" RequestedTheme="Dark">
                <Border x:Name="HeroFill" Background="#1F2937" />
                <Image x:Name="Backdrop" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" local:Art.DecodeWidth="1280" />
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#33000000" Offset="0" />
                            <GradientStop Color="#99000000" Offset="0.55" />
                            <GradientStop Color="#E6000000" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Grid Padding="28" ColumnSpacing="24" VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="PosterFrame" Width="150" Height="225" CornerRadius="8" VerticalAlignment="Bottom"
                          BorderBrush="#33FFFFFF" BorderThickness="1">
                        <Border x:Name="PosterFill">
                            <TextBlock x:Name="PosterInitials" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="40" FontWeight="SemiBold" Opacity="0.85" />
                        </Border>
                        <Image x:Name="Poster" Stretch="UniformToFill" local:Art.DecodeWidth="480" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="6">
                        <TextBlock x:Name="TypeText" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" CharacterSpacing="80" Opacity="0.8" />
                        <TextBlock x:Name="TitleText" FontSize="34" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display"
                                   TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                        <TextBlock x:Name="MetaText" TextWrapping="Wrap" Opacity="0.85" IsTextSelectionEnabled="True" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                            <Border x:Name="RatingPill" Padding="10,4" CornerRadius="4" Background="#33FFFFFF">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE735;" FontSize="12" Foreground="#FFD166" />
                                    <TextBlock x:Name="RatingText" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="CountdownPill" Padding="10,4" CornerRadius="4" Background="#33FFFFFF">
                                <TextBlock x:Name="CountdownText" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                            </Border>
                            <Border x:Name="EpisodesPill" Padding="10,4" CornerRadius="4" Background="#33FFFFFF">
                                <TextBlock x:Name="EpisodesText" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Actions -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="PrimaryButton" Style="{StaticResource AccentButtonStyle}" Click="Primary_Click" />
                    <Button x:Name="TrailerButton" Click="Trailer_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                            <TextBlock Text="Trailer" />
                        </StackPanel>
                    </Button>
                    <DropDownButton x:Name="StatusButton" Content="Move to" />
                    <DropDownButton x:Name="LinksButton" Content="Links" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="EditButton" Click="Edit_Click" ToolTipService.ToolTip="Edit details" AutomationProperties.Name="Edit details">
                        <FontIcon Glyph="&#xE70F;" FontSize="14" />
                    </Button>
                    <Button x:Name="RemoveButton" Click="Remove_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            <TextBlock x:Name="RemoveLabel" Text="Remove" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Body: story on the left, facts on the right; one column when narrow. -->
            <Grid x:Name="Body" ColumnSpacing="20" RowSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="SideColumn" Width="340" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel x:Name="MainColumn" Spacing="20">
                    <Border x:Name="OverviewCard" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Overview" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock x:Name="OverviewText" TextWrapping="Wrap" IsTextSelectionEnabled="True" LineHeight="22" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <Grid>
                                <TextBlock x:Name="StoryHeading" Text="Story" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                    <ProgressRing x:Name="StoryBusy" Width="18" Height="18" IsActive="False" />
                                    <HyperlinkButton x:Name="RefreshStoryButton" Content="Refresh from Wikipedia" Click="RefreshStory_Click" Padding="8,4" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="StoryText" TextWrapping="Wrap" IsTextSelectionEnabled="True" LineHeight="22" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="EpisodesCard" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Episodes" Style="{StaticResource SectionTitleStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ComboBox x:Name="SeasonBox" Header="Season" MinWidth="110" SelectionChanged="Season_Changed" />
                                <ComboBox x:Name="EpisodeBox" Header="Episode" MinWidth="320" MaxWidth="460" />
                                <Button Content="Show episode story" VerticalAlignment="Bottom" Click="EpisodeStory_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="SidePanel" Grid.Column="1" Spacing="20">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Your rating" Style="{StaticResource SectionTitleStyle}" />
                            <RatingControl x:Name="MyRating" MaxRating="10" IsClearEnabled="True" HorizontalAlignment="Left" ValueChanged="MyRating_ValueChanged" />
                            <TextBlock x:Name="MyRatingText" Style="{StaticResource CaptionSecondaryStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock x:Name="AvailabilityHeading" Text="Where to watch" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock x:Name="AvailabilityText" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource SecondaryTextStyle}" />
                            <StackPanel x:Name="VendorButtons" Orientation="Horizontal" Spacing="8">
                                <DropDownButton x:Name="VendorLinksButton" Content="Rental shops" />
                                <Button x:Name="VendorRefreshButton" Content="Check again" Click="VendorRefresh_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="FactsCard" Style="{StaticResource CardStyle}">
                        <StackPanel x:Name="Facts" Spacing="10">
                            <TextBlock Text="Details" Style="{StaticResource SectionTitleStyle}" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="NoteCard" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Notes" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock x:Name="NoteText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
