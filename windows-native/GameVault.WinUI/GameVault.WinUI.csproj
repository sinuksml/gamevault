<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Sinu Game Vault for Windows, WinUI 3 edition.

    Unpackaged and self-contained: the output folder runs on a clean Windows 10
    1809+ or Windows 11 machine with no .NET or Windows App SDK installed, which
    is what lets Inno Setup ship it as an ordinary installer.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SinuGameVault</AssemblyName>
    <RootNamespace>SinuGameVault</RootNamespace>
    <!-- Version comes from ..\Directory.Build.props -->
    <Authors>Sinu Game Vault</Authors>
    <Product>Sinu Game Vault for Windows</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\GameVault.ico</ApplicationIcon>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <ProjectReference Include="..\GameVault.Core\GameVault.Core.csproj" />
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
