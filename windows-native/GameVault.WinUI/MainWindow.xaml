<Window
    x:Class="SinuGameVault.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" PointerPressed="RootGrid_PointerPressed" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar"
                  Title="Sinu Game Vault"
                  IsBackButtonVisible="True"
                  IsBackButtonEnabled="False"
                  IsPaneToggleButtonVisible="True"
                  BackRequested="TitleBar_BackRequested"
                  PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/GameVault.png" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <AutoSuggestBox x:Name="SearchBox"
                                Width="380"
                                VerticalAlignment="Center"
                                PlaceholderText="Search (Ctrl+K)"
                                QueryIcon="Find"
                                IsEnabled="False"
                                TextChanged="SearchBox_TextChanged" />
            </TitleBar.Content>
            <TitleBar.RightHeader>
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock x:Name="DriveStatusText"
                               VerticalAlignment="Center"
                               MaxWidth="220"
                               TextTrimming="CharacterEllipsis"
                               Style="{StaticResource CaptionSecondaryStyle}" />
                    <Button x:Name="SyncButton"
                            Click="Sync_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="8"
                            ToolTipService.ToolTip="Sync and refresh (Ctrl+R)"
                            AutomationProperties.Name="Sync and refresh">
                        <FontIcon Glyph="&#xE895;" FontSize="14" />
                    </Button>
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>

        <NavigationView x:Name="Nav"
                        Grid.Row="1"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        PaneDisplayMode="Left"
                        OpenPaneLength="228"
                        IsSettingsVisible="True"
                        ItemInvoked="Nav_ItemInvoked">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" Tag="Home">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Games" Tag="Games">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7FC;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Movies" Tag="Movies">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8B2;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="TV Shows" Tag="Series">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7F4;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem Content="Plex" Tag="Plex">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE768;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Downloads" Tag="Downloads">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE896;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Petrol" Tag="Petrol">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE804;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <Frame x:Name="ContentFrame" Navigated="ContentFrame_Navigated" />
                <ProgressBar x:Name="BusyBar" IsIndeterminate="True" VerticalAlignment="Top" Visibility="Collapsed" />
                <InfoBar x:Name="Toast"
                         VerticalAlignment="Bottom"
                         HorizontalAlignment="Center"
                         Margin="24"
                         MaxWidth="760"
                         IsOpen="False"
                         Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}">
                    <InfoBar.ActionButton>
                        <Button x:Name="UndoButton" Content="Undo" Click="Undo_Click" />
                    </InfoBar.ActionButton>
                </InfoBar>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
