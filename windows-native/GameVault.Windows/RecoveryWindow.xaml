<Window x:Class="SinuGameVault.RecoveryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recovery snapshots" Width="820" Height="590" MinWidth="680" MinHeight="440" WindowStartupLocation="CenterOwner">
    <Grid Margin="26">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Recovery snapshots" FontSize="24" FontWeight="Bold"/><TextBlock Text="GameVault creates snapshots before imports and during edits. Select one to restore the entire native vault." Style="{StaticResource MutedText}" Margin="0,6,0,0"/></StackPanel>
        <DataGrid Grid.Row="2" x:Name="SnapshotGrid" IsReadOnly="True" SelectionMode="Single" AutoGenerateColumns="False">
            <DataGrid.Columns><DataGridTextColumn Header="Created" Binding="{Binding ModifiedAt, StringFormat={}{0:dd MMM yyyy, h:mm tt}}" Width="220"/><DataGridTextColumn Header="Snapshot" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="110"/></DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="4"><TextBlock Text="Restoring also keeps a snapshot of the current vault." Style="{StaticResource MutedText}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Close" Click="Close_Click" Margin="0,0,8,0"/><Button Content="Restore selected" Style="{StaticResource PrimaryButton}" Click="Restore_Click"/></StackPanel></DockPanel>
    </Grid>
</Window>
