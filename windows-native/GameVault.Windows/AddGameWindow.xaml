<Window x:Class="SinuGameVault.AddGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add game" Width="520" Height="470" MinWidth="500" MinHeight="450" WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBrush}">
    <Grid Margin="28" Background="{DynamicResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Add to GameVault" FontSize="26" FontWeight="Bold" />
        <TextBlock Grid.Row="1" Text="Create a native library entry. Cover enrichment will be added in the online-services phase."
                   Style="{StaticResource MutedText}" Margin="0,6,0,20" TextWrapping="Wrap" />
        <StackPanel Grid.Row="2" Margin="0,0,0,14">
            <TextBlock Text="Game title" Margin="0,0,0,6" />
            <TextBox x:Name="NameBox" />
        </StackPanel>
        <Grid Grid.Row="3" Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Collection" Margin="0,0,0,6" />
                <ComboBox x:Name="CollectionBox" SelectedIndex="0">
                    <ComboBoxItem Content="Now Playing" Tag="playing" />
                    <ComboBoxItem Content="Rental Queue" Tag="queue" />
                    <ComboBoxItem Content="Completed" Tag="played" />
                    <ComboBoxItem Content="Upcoming" Tag="upcoming" />
                    <ComboBoxItem Content="Subscription game" Tag="subscriptionGames" />
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Platform" Margin="0,0,0,6" />
                <ComboBox x:Name="PlatformBox" SelectedIndex="0">
                    <ComboBoxItem Content="PS5"/><ComboBoxItem Content="Xbox Series X|S"/><ComboBoxItem Content="PC"/>
                </ComboBox>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="4">
            <TextBlock Text="Date (optional, YYYY-MM-DD)" Margin="0,0,0,6" />
            <TextBox x:Name="DateBox" />
        </StackPanel>
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="100" Margin="0,0,10,0" IsCancel="True" />
            <Button Content="Add game" Width="120" Style="{StaticResource PrimaryButton}" Click="Add_Click" />
        </StackPanel>
    </Grid>
</Window>
