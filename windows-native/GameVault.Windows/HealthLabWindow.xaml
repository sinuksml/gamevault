<Window x:Class="SinuGameVault.HealthLabWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add lab result" Width="520" Height="560" WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}">
    <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Add lab result" FontSize="25" FontWeight="Bold"/>
        <StackPanel Grid.Row="1" Margin="0,20,0,0"><TextBlock Text="Date"/><DatePicker x:Name="DateBox" Margin="0,6,0,12"/><TextBlock Text="Test name"/><TextBox x:Name="TestBox" Margin="0,6,0,12"/><TextBlock Text="Value"/><TextBox x:Name="ValueBox" Margin="0,6,0,12"/><TextBlock Text="Unit"/><TextBox x:Name="UnitBox" Margin="0,6,0,12"/><TextBlock Text="Reference range"/><TextBox x:Name="RangeBox" Margin="0,6,0,12"/><TextBlock Text="Notes"/><TextBox x:Name="NoteBox" Height="60" Margin="0,6,0,0" AcceptsReturn="True"/></StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" IsCancel="True" Width="100" Margin="0,0,10,0"/><Button Content="Save" Width="110" Style="{StaticResource PrimaryButton}" Click="Save_Click"/></StackPanel>
    </Grid>
</Window>
