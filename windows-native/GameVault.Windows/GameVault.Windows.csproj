<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Legacy WPF edition, kept buildable as a fallback while the WinUI 3 edition
    (..\GameVault.WinUI) settles in. Releases are built from the WinUI project.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SinuGameVault</AssemblyName>
    <RootNamespace>SinuGameVault</RootNamespace>
    <!-- Version comes from ..\Directory.Build.props -->
    <Authors>Sinu Game Vault</Authors>
    <Product>Sinu Game Vault for Windows</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\GameVault.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\GameVault.Core\GameVault.Core.csproj" />
    <Resource Include="Assets\GameVault.ico" />
  </ItemGroup>
</Project>
