<Window x:Class="SinuGameVault.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sinu Game Vault" Width="1440" Height="900" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown" SizeChanged="Window_SizeChanged">
    <Window.Resources>
        <DataTemplate x:Key="DashboardRowTemplate">
            <Button Tag="{Binding}" Click="LibraryCard_Click" Padding="0" Margin="0,0,0,10" Height="86"
                    Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Background="#172235" CornerRadius="7,0,0,7" ClipToBounds="True">
                        <Grid><TextBlock Text="GV" Foreground="#3A4D67" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Image}" Stretch="UniformToFill"/></Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="15,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding DetailMeta}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="12,0,16,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding DaysText}" Foreground="{Binding CountdownColor}" FontWeight="Bold" Margin="0,5,0,0" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="LibraryCardTemplate">
            <Button Tag="{Binding}" Click="LibraryCard_Click" Padding="0" Margin="0,0,18,22" Width="220" Height="372"
                    Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Button.ContextMenu><ContextMenu><MenuItem Header="Primary action" Tag="primary" Click="CardQuickAction_Click"/><Separator/><MenuItem Header="Add to watchlist / queue" Tag="watchlist" Click="CardQuickAction_Click"/><MenuItem Header="Mark watched / completed" Tag="watched" Click="CardQuickAction_Click"/><MenuItem Header="Not interested" Tag="hidden" Click="CardQuickAction_Click"/></ContextMenu></Button.ContextMenu>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="286"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="#172235" CornerRadius="7,7,0,0" ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="GV" FontSize="36" FontWeight="Bold" Foreground="#30445E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image Source="{Binding Image}" Stretch="UniformToFill"/>
                            <Border Visibility="{Binding HasBadges, Converter={StaticResource BoolToVisibility}}" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#E60A0D14" BorderBrush="#657C9C" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="9"><TextBlock Text="{Binding Badges}" Foreground="#DCE9F8" FontSize="10" FontWeight="Bold" MaxWidth="180" TextTrimming="CharacterEllipsis"/></Border>
                            <Border VerticalAlignment="Bottom" Background="#E6090D14" Padding="11,8">
                                <DockPanel>
                                    <TextBlock Text="{Binding CardRatingText}" Foreground="#FFD166" FontWeight="Bold" FontSize="12"/>
                                    <TextBlock Text="{Binding DaysText}" Foreground="{Binding CountdownColor}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="1" Margin="12,10">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding PrimaryMeta}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SecondaryMeta}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="LibraryListTemplate">
            <Button Tag="{Binding}" Click="LibraryCard_Click" Padding="0" Margin="0,0,0,10" Height="104"
                    Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" HorizontalContentAlignment="Stretch">
                <Button.ContextMenu><ContextMenu><MenuItem Header="Primary action" Tag="primary" Click="CardQuickAction_Click"/><Separator/><MenuItem Header="Add to watchlist / queue" Tag="watchlist" Click="CardQuickAction_Click"/><MenuItem Header="Mark watched / completed" Tag="watched" Click="CardQuickAction_Click"/><MenuItem Header="Not interested" Tag="hidden" Click="CardQuickAction_Click"/></ContextMenu></Button.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                    <Border Background="#172235" CornerRadius="7,0,0,7" ClipToBounds="True"><Grid><TextBlock Text="GV" Foreground="#30445E" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding Image}" Stretch="UniformToFill"/></Grid></Border>
                    <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding DetailMeta}" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding Status}" FontWeight="SemiBold"/><TextBlock Text="{Binding Date}" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,5,0,0"/></StackPanel>
                    <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0"><TextBlock Text="{Binding CardRatingText}" Foreground="#FFD166" FontWeight="Bold"/><TextBlock Text="{Binding DaysText}" Foreground="{Binding CountdownColor}" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
    </Window.Resources>
    <Grid Background="{DynamicResource WindowBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="RailColumn" Width="244"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Image x:Name="SectionBackdrop" Grid.ColumnSpan="2" Stretch="UniformToFill" Opacity="0.16" IsHitTestVisible="False"/>
        <Border Grid.ColumnSpan="2" Background="{DynamicResource BackdropScrimBrush}" IsHitTestVisible="False"/>

        <Border Background="{DynamicResource RailBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="18,24">
                <StackPanel x:Name="RailNavigation" DockPanel.Dock="Top">
                    <Border Width="48" Height="48" CornerRadius="10" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left">
                        <TextBlock Text="GV" Foreground="#071018" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="SINU GAME VAULT" FontSize="16" FontWeight="Bold" Margin="0,14,0,2" />
                    <TextBlock Text="Your private entertainment library" Style="{StaticResource MutedText}" Margin="0,0,0,24" TextWrapping="Wrap" />
                    <TextBlock Text="LIBRARY" Style="{StaticResource KickerText}" Margin="14,0,0,6"/>
                    <Button x:Name="HomeRailButton" Content="⌂   Home" Tag="Overview" Style="{StaticResource RailButton}" Click="Navigate_Click" />
                    <Button x:Name="GamesRailButton" Content="▣   Games" Tag="Games" Style="{StaticResource RailButton}" Click="Navigate_Click" />
                    <Button x:Name="MoviesRailButton" Content="●   Movies" Tag="Movies" Style="{StaticResource RailButton}" Click="Navigate_Click" />
                    <Button x:Name="SeriesRailButton" Content="▤   TV Shows" Tag="Series" Style="{StaticResource RailButton}" Click="Navigate_Click" />
                    <Separator Margin="0,12" Background="{DynamicResource DividerBrush}" />
                    <TextBlock Text="SERVICES" Style="{StaticResource KickerText}" Margin="14,0,0,6"/>
                    <Button Content="▶   Plex" Tag="Plex" Style="{StaticResource RailButton}" Click="Navigate_Click" />
                    <Button Content="⇩   BiglyBT" Tag="BiglyBT" Style="{StaticResource RailButton}" Click="Navigate_Click" />
                    <Button Content="♥   Health" Tag="Health" Style="{StaticResource RailButton}" Click="Navigate_Click" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                    <Button Content="⚙   Settings" Tag="Settings" Style="{StaticResource RailButton}" Click="Navigate_Click" />
                    <TextBlock x:Name="VersionText" Text="Windows 2.0.3" Style="{StaticResource MutedText}" Margin="14,8" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="84"/><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
            <Border Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="28,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel x:Name="PageHeading" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock x:Name="PageTitle" Text="Overview" FontSize="25" FontWeight="Bold" />
                        <TextBlock x:Name="PageSubtitle" Text="Your library at a glance" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="FeaturedTitleText" Text="" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                        <TextBlock x:Name="DriveHeaderStatus" Text="Drive offline" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <TextBox x:Name="SearchBox" Width="260" Margin="0,0,10,0" ToolTip="Search the current tab (Ctrl+K)" TextChanged="SearchBox_TextChanged" />
                        <Button x:Name="ThemeButton" Content="Light mode" Margin="0,0,8,0" Click="Theme_Click"/>
                        <Button Content="Refresh" Click="GlobalRefresh_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="28,22">
                <Grid x:Name="OverviewPage">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource SurfaceCard}" Padding="26">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="YOUR LIBRARY TODAY" Style="{StaticResource KickerText}"/>
                                <TextBlock Text="Pick up where you stopped." FontSize="28" FontWeight="Bold" Margin="0,7,0,4"/>
                                <TextBlock x:Name="HomeSummaryText" Text="Rentals, watchlists and upcoming releases are ready." Style="{StaticResource MutedText}"/>
                            </StackPanel>
                            <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="26,0,0,0">
                                <Button Content="Now playing" Tag="Games" Style="{StaticResource PrimaryButton}" Click="HomeShortcut_Click" Margin="0,0,8,8"/>
                                <Button Content="Movie watchlist" Tag="Movies" Click="HomeShortcut_Click" Margin="0,0,8,8"/>
                                <Button Content="Sync Drive" Click="DriveSync_Click" Margin="0,0,0,8"/>
                            </WrapPanel>
                        </Grid>
                    </Border>
                    <UniformGrid x:Name="OverviewStats" Grid.Row="2" Columns="6">
                        <Border Style="{StaticResource SurfaceCard}" Padding="18" Margin="0,0,8,0">
                            <StackPanel><TextBlock Text="ACTIVE RENTALS" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="12"/><TextBlock x:Name="RentalCount" Text="0" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock Text="games currently rented" Style="{StaticResource MutedText}"/></StackPanel>
                        </Border>
                        <Border Style="{StaticResource SurfaceCard}" Padding="18" Margin="4,0,4,0">
                            <StackPanel><TextBlock Text="NOW PLAYING" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="12"/><TextBlock x:Name="PlayingCount" Text="0" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock Text="active games" Style="{StaticResource MutedText}"/></StackPanel>
                        </Border>
                        <Border Style="{StaticResource SurfaceCard}" Padding="18" Margin="4,0,4,0">
                            <StackPanel><TextBlock Text="WATCHLIST" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="12"/><TextBlock x:Name="WatchlistCount" Text="0" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock Text="movies and TV shows" Style="{StaticResource MutedText}"/></StackPanel>
                        </Border>
                        <Border Style="{StaticResource SurfaceCard}" Padding="18" Margin="4,0,4,0">
                            <StackPanel><TextBlock Text="COMPLETED" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="12"/><TextBlock x:Name="CompletedCount" Text="0" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock Text="games finished" Style="{StaticResource MutedText}"/></StackPanel>
                        </Border>
                        <Border Style="{StaticResource SurfaceCard}" Padding="18" Margin="4,0,4,0"><StackPanel><TextBlock Text="TOTAL RENTED" Foreground="#A45BDD" FontWeight="Bold" FontSize="12"/><TextBlock x:Name="TotalRentedCount" Text="0" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock Text="all rental periods" Style="{StaticResource MutedText}"/></StackPanel></Border>
                        <Border Style="{StaticResource SurfaceCard}" Padding="18" Margin="4,0,0,0"><StackPanel><TextBlock Text="TOTAL SPENT" Foreground="#C28A00" FontWeight="Bold" FontSize="12"/><TextBlock x:Name="TotalSpentCount" Text="₹0" FontSize="24" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock Text="rentals + subscriptions" Style="{StaticResource MutedText}"/></StackPanel></Border>
                    </UniformGrid>
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource SurfaceCard}">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <StackPanel><TextBlock Text="Continue where you left off" Style="{StaticResource SectionTitle}"/><TextBlock Text="Open a title to see its details and actions." Style="{StaticResource MutedText}" Margin="0,5,0,14"/></StackPanel>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="ContinueCards" ItemTemplate="{StaticResource DashboardRowTemplate}"/></ScrollViewer>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource SurfaceCard}">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <StackPanel><TextBlock Text="Coming up" Style="{StaticResource SectionTitle}"/><TextBlock Text="Nearest game, film and TV dates." Style="{StaticResource MutedText}" Margin="0,5,0,14"/></StackPanel>
                                <ScrollViewer Grid.Row="1" MaxHeight="250" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="UpcomingCards" ItemTemplate="{StaticResource DashboardRowTemplate}"/></ScrollViewer>
                                <TextBlock Grid.Row="2" Text="Recent activity" Style="{StaticResource SectionTitle}" Margin="0,18,0,8"/>
                                <ListBox Grid.Row="3" x:Name="RecentActivityList" MaxHeight="150" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource MutedBrush}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <Grid x:Name="GamesPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <WrapPanel Grid.Column="0">
                            <Button Content="Add game" Style="{StaticResource PrimaryButton}" Click="AddGame_Click" Margin="0,0,8,8"/>
                            <Button Content="Edit selected" Margin="0,0,8,8" Click="EditSelected_Click"/><Button Content="Rental history" Margin="0,0,8,8" Click="RentalHistory_Click"/><Button Content="Vendor report" Margin="0,0,8,8" Click="VendorReport_Click"/><Button Content="Subscriptions" Margin="0,0,8,8" Click="ManageSubscriptions_Click"/><Button Content="Refresh online" Margin="0,0,8,8" Click="RefreshOnline_Click"/>
                        </WrapPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Top">
                            <ComboBox x:Name="GameSortBox" Width="150" SelectionChanged="LibrarySort_Changed"><ComboBoxItem Content="Newest first" Tag="new"/><ComboBoxItem Content="Title A-Z" Tag="title"/><ComboBoxItem Content="Release date" Tag="date"/><ComboBoxItem Content="Rating" Tag="rating"/></ComboBox>
                            <Button x:Name="GameViewButton" Content="List view" Margin="8,0,0,0" Click="GameView_Click"/>
                        </StackPanel>
                    </Grid>
                    <TabControl x:Name="GamesTabs" Grid.Row="2" SelectionChanged="GamesTabs_SelectionChanged">
                        <TabItem Header="Rentals" Tag="rentals"/><TabItem Header="Subscriptions" Tag="subscriptionGames"/>
                        <TabItem Header="Now Playing" Tag="playing"/><TabItem Header="Rental Queue" Tag="queue"/>
                        <TabItem Header="Upcoming" Tag="upcoming"/><TabItem Header="Discover" Tag="catalogExtra"/><TabItem Header="Completed" Tag="played"/>
                    </TabControl>
                    <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="GamesCards" ItemTemplate="{StaticResource LibraryCardTemplate}">
                            <ItemsControl.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" FontSize="19" FontWeight="Bold" Margin="0,14,0,14"/></DataTemplate></GroupStyle.HeaderTemplate><GroupStyle.Panel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></GroupStyle.Panel></GroupStyle></ItemsControl.GroupStyle>
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                    <ScrollViewer x:Name="GamesListScroll" Grid.Row="4" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <ItemsControl x:Name="GamesList" ItemTemplate="{StaticResource LibraryListTemplate}"><ItemsControl.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" FontSize="19" FontWeight="Bold" Margin="0,14,0,12"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ItemsControl.GroupStyle></ItemsControl>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="MediaPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <WrapPanel x:Name="MediaTabsPanel"/>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <WrapPanel Grid.Column="0">
                                <Button Content="Add title" Style="{StaticResource PrimaryButton}" Click="AddMedia_Click" Margin="0,0,8,8"/>
                                <Button Content="Edit selected" Margin="0,0,8,8" Click="EditSelected_Click"/>
                                <Button Content="Find online" Margin="0,0,8,8" Click="FindOnline_Click"/>
                                <Button Content="Refresh this catalog" Margin="0,0,8,8" Click="RefreshOnline_Click"/>
                            </WrapPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Top">
                                <ComboBox x:Name="MediaYearBox" Width="115" SelectionChanged="MediaFilter_Changed"><ComboBoxItem Content="All years" Tag=""/></ComboBox>
                                <TextBox x:Name="MediaGenreBox" Width="140" Margin="8,0,0,0" ToolTip="Genre filter" TextChanged="MediaGenre_TextChanged"/>
                                <ComboBox x:Name="MediaSortBox" Width="145" Margin="8,0,0,0" SelectionChanged="LibrarySort_Changed"><ComboBoxItem Content="Newest first" Tag="new"/><ComboBoxItem Content="Title A-Z" Tag="title"/><ComboBoxItem Content="Rating" Tag="rating"/></ComboBox>
                                <Button x:Name="MediaViewButton" Content="List view" Margin="8,0,0,0" Click="MediaView_Click"/>
                            </StackPanel>
                    </Grid>
                    <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="MediaCards" ItemTemplate="{StaticResource LibraryCardTemplate}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                    <ScrollViewer x:Name="MediaListScroll" Grid.Row="4" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <ItemsControl x:Name="MediaList" ItemTemplate="{StaticResource LibraryListTemplate}"/>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="PlaceholderPage" Visibility="Collapsed">
                    <Border Style="{StaticResource SurfaceCard}" Padding="32" MaxWidth="760" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock x:Name="PlaceholderTitle" Text="Integration" FontSize="24" FontWeight="Bold" />
                            <TextBlock x:Name="PlaceholderMessage" Text="This native integration is scheduled for a later phase." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="PlexPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel>
                        <StackPanel Orientation="Horizontal"><Button Content="Continue Watching" Tag="continue" Style="{StaticResource PrimaryButton}" Click="PlexMode_Click"/><Button Content="All Library" Tag="all" Margin="8,0,0,0" Click="PlexMode_Click"/><Button Content="Movies" Tag="movie" Margin="8,0,0,0" Click="PlexMode_Click"/><Button Content="TV Shows" Tag="show" Margin="8,0,0,0" Click="PlexMode_Click"/><Button Content="Recently Added" Tag="recent" Margin="8,0,0,0" Click="PlexMode_Click"/></StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock x:Name="PlexStatusText" Text="Not connected" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Content="Refresh library" Click="PlexRefresh_Click"/></StackPanel>
                    </DockPanel>
                    <Border x:Name="PlexSetupPanel" Grid.Row="2" Style="{StaticResource SurfaceCard}" Padding="28" MaxWidth="760" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <StackPanel><TextBlock Text="Connect Plex Media Server" FontSize="22" FontWeight="Bold"/><TextBlock Text="Enter the server URL and X-Plex-Token in Settings. They are stored only in Windows Credential Manager." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,16"/><Button Content="Open Settings" Tag="Settings" Style="{StaticResource PrimaryButton}" Click="Navigate_Click" HorizontalAlignment="Left"/></StackPanel>
                    </Border>
                    <ScrollViewer x:Name="PlexLibraryScroll" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="PlexCards" ItemTemplate="{StaticResource LibraryCardTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="BiglyPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <WrapPanel><Button Content="Paste and add magnet" Style="{StaticResource PrimaryButton}" Click="BiglyPaste_Click" Margin="0,0,8,8"/><Button Content="Refresh" Margin="0,0,8,8" Click="BiglyRefresh_Click"/><Button Content="Start" Margin="0,0,8,8" Click="BiglyStart_Click"/><Button Content="Pause" Margin="0,0,8,8" Click="BiglyStop_Click"/><Button Content="Remove (keep files)" Margin="0,0,8,8" Click="BiglyRemove_Click"/><Button Content="Delete files" Foreground="{DynamicResource DangerBrush}" Margin="0,0,8,8" Click="BiglyDelete_Click"/><ComboBox x:Name="BiglyPriorityBox" Width="110" Margin="0,0,8,8" SelectedIndex="0" SelectionChanged="BiglyPriority_Changed"><ComboBoxItem Content="Priority" Tag=""/><ComboBoxItem Content="High" Tag="1"/><ComboBoxItem Content="Normal" Tag="0"/><ComboBoxItem Content="Low" Tag="-1"/></ComboBox></WrapPanel>
                        <StackPanel Grid.Row="2" Orientation="Horizontal"><TextBlock x:Name="BiglyStatusText" Text="Not connected" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Content="History" Click="BiglyHistory_Click"/></StackPanel>
                    </Grid>
                    <UniformGrid Grid.Row="2" Columns="3">
                        <Border Style="{StaticResource StatCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="ACTIVE" Style="{StaticResource StatLabel}"/><TextBlock x:Name="BiglyActiveCount" Text="0" Style="{StaticResource StatValue}"/></StackPanel></Border>
                        <Border Style="{StaticResource StatCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="TRANSFER SPEED" Style="{StaticResource StatLabel}"/><TextBlock x:Name="BiglyTransferSpeed" Text="0 B/s" Style="{StaticResource StatValue}"/></StackPanel></Border>
                        <Border Style="{StaticResource StatCard}"><StackPanel><TextBlock Text="DATA REMAINING" Style="{StaticResource StatLabel}"/><TextBlock x:Name="BiglyRemainingData" Text="0 B" Style="{StaticResource StatValue}"/></StackPanel></Border>
                    </UniformGrid>
                    <Border x:Name="BiglySetupPanel" Grid.Row="4" Style="{StaticResource SurfaceCard}" Padding="28" MaxWidth="760" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <StackPanel><TextBlock Text="Connect BiglyBT" FontSize="22" FontWeight="Bold"/><TextBlock Text="The native dashboard uses your secure Cloudflare gateway API. The endpoint and saved login remain in Windows Credential Manager." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,16"/><Button Content="Open Settings" Tag="Settings" Style="{StaticResource PrimaryButton}" Click="Navigate_Click" HorizontalAlignment="Left"/></StackPanel>
                    </Border>
                    <DataGrid x:Name="BiglyGrid" Grid.Row="4" Visibility="Collapsed" ItemsSource="{Binding}" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Torrent" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                            <DataGridTextColumn Header="Progress" Binding="{Binding ProgressText}" Width="90"/>
                            <DataGridTextColumn Header="Downloaded / Total" Binding="{Binding AmountText}" Width="180"/>
                            <DataGridTextColumn Header="Speed" Binding="{Binding SpeedText}" Width="210"/>
                            <DataGridTextColumn Header="ETA" Binding="{Binding EtaText}" Width="90"/>
                            <DataGridTextColumn Header="Peers" Binding="{Binding Peers}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <DataGrid x:Name="BiglyHistoryGrid" Grid.Row="4" Visibility="Collapsed" IsReadOnly="True">
                        <DataGrid.Columns><DataGridTextColumn Header="Title" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Outcome" Binding="{Binding Outcome}" Width="210"/><DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="170"/><DataGridTextColumn Header="Progress" Binding="{Binding Progress}" Width="100"/><DataGridTextColumn Header="Downloaded" Binding="{Binding Downloaded}" Width="130"/><DataGridTextColumn Header="Files" Binding="{Binding Files}" Width="110"/></DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <Grid x:Name="HealthPage" Visibility="Collapsed">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Weekly nutrition and activity" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="Track the practical targets derived from your health report. This stays in the same encrypted Drive backup as the rest of GameVault." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,7,0,16"/>
                        <UniformGrid Columns="2" Margin="0,0,0,16">
                            <Border Style="{StaticResource SurfaceCard}" BorderBrush="#277A65" Padding="18" Margin="0,0,8,8"><StackPanel><TextBlock Text="PLANT-BASED MEALS" Foreground="#238365" FontWeight="Bold" FontSize="11"/><TextBlock x:Name="PlantMealsText" Text="0 / 10" FontSize="27" FontWeight="Bold" Margin="0,6,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource SurfaceCard}" BorderBrush="#31577D" Padding="18" Margin="0,0,0,8"><StackPanel><TextBlock Text="ACTIVITY" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="11"/><TextBlock x:Name="ActivityText" Text="0 / 150 min" FontSize="27" FontWeight="Bold" Margin="0,6,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource SurfaceCard}" BorderBrush="#94791F" Padding="18" Margin="0,0,8,0"><StackPanel><TextBlock Text="FISH MEALS" Foreground="#C28A00" FontWeight="Bold" FontSize="11"/><TextBlock x:Name="FishMealsText" Text="0 / 2" FontSize="27" FontWeight="Bold" Margin="0,6,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource SurfaceCard}" BorderBrush="#A64B58" Padding="18"><StackPanel><TextBlock Text="RED MEAT / FRIED" Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" FontSize="11"/><TextBlock x:Name="LimitMealsText" Text="0 / 2" FontSize="27" FontWeight="Bold" Margin="0,6,0,0"/></StackPanel></Border>
                        </UniformGrid>
                        <ListBox x:Name="HealthLogList" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel></ScrollViewer>
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="22" Margin="0,0,10,0">
                        <StackPanel><TextBlock Text="Add health entry" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="Date" Margin="0,16,0,6"/><DatePicker x:Name="HealthDateBox"/>
                            <TextBlock Text="Meal / activity" Margin="0,12,0,6"/><ComboBox x:Name="HealthTypeBox" SelectedIndex="0"><ComboBoxItem Content="Plant-based meal" Tag="plant"/><ComboBoxItem Content="Fish meal" Tag="fish"/><ComboBoxItem Content="Poultry / egg meal" Tag="poultry"/><ComboBoxItem Content="Red meat meal" Tag="redMeat"/><ComboBoxItem Content="Fried / takeaway meal" Tag="fried"/><ComboBoxItem Content="Sugary item" Tag="sugary"/><ComboBoxItem Content="Fruit serving" Tag="fruit"/><ComboBoxItem Content="Vegetable serving" Tag="vegetable"/><ComboBoxItem Content="Whole grain / legume meal" Tag="wholeGrain"/><ComboBoxItem Content="Water cup" Tag="water"/><ComboBoxItem Content="Activity minutes" Tag="activity"/><ComboBoxItem Content="Strength day" Tag="strength"/><ComboBoxItem Content="Sleep hours" Tag="sleep"/></ComboBox>
                            <TextBlock Text="Amount / minutes" Margin="0,12,0,6"/><TextBox x:Name="HealthAmountBox" Text="1"/>
                            <TextBlock Text="Notes" Margin="0,12,0,6"/><TextBox x:Name="HealthNoteBox" Height="74" AcceptsReturn="True" TextWrapping="Wrap"/>
                            <Button Content="Save entry" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0" Click="HealthAdd_Click"/>
                            <Separator Margin="0,22" Background="{DynamicResource DividerBrush}"/>
                            <TextBlock Text="Lab results and doctor notes" FontSize="17" FontWeight="SemiBold"/><Button Content="Add lab result" Margin="0,12,0,0" Click="HealthLab_Click"/><Button Content="Edit health targets" Margin="0,8,0,0" Click="HealthTargets_Click"/>
                        </StackPanel>
                    </Border></ScrollViewer>
                </Grid>

                <Grid x:Name="SettingsPage" Visibility="Collapsed">
                    <TabControl TabStripPlacement="Left" MaxWidth="1120" HorizontalAlignment="Stretch" ItemContainerStyle="{StaticResource SettingsTabItem}">
                        <TabItem Header="General">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource SurfaceCard}" Margin="18,0,0,0" MaxWidth="820"><StackPanel>
                                <TextBlock Text="General and appearance" FontSize="22" FontWeight="Bold"/><TextBlock Text="Choose the Windows presentation without changing the web or TV interface." Style="{StaticResource MutedText}" Margin="0,7,0,18"/>
                                <TextBlock Text="APPEARANCE" Style="{StaticResource KickerText}"/><WrapPanel Margin="0,10,0,18"><Button Content="Dark" Tag="dark" Click="SetTheme_Click" Margin="0,0,8,8"/><Button Content="Light" Tag="light" Click="SetTheme_Click" Margin="0,0,8,8"/><Button Content="OLED black" Tag="oled" Click="SetTheme_Click" Margin="0,0,8,8"/></WrapPanel>
                                <TextBlock Text="LOCAL VAULT" Style="{StaticResource KickerText}"/><TextBlock x:Name="VaultPathText" TextWrapping="Wrap" Margin="0,7,0,14"/><Button Content="Open data folder" Click="OpenVaultFolder_Click" HorizontalAlignment="Left"/>
                                <Separator Margin="0,24"/><TextBlock Text="Keyboard shortcuts" Style="{StaticResource SectionTitle}"/><TextBlock Text="Ctrl+K search · Ctrl+R refresh · Ctrl+, settings · Alt+Left go back · Esc close details" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                            </StackPanel></Border></ScrollViewer>
                        </TabItem>
                        <TabItem Header="Cloud and APIs">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource SurfaceCard}" Margin="18,0,0,0" MaxWidth="820"><StackPanel>
                                <TextBlock Text="Google Drive" FontSize="22" FontWeight="Bold"/><TextBlock Text="Authentication tokens and API keys are stored in Windows Credential Manager." Style="{StaticResource MutedText}" Margin="0,7,0,16"/>
                                <TextBlock Text="Google OAuth Client ID" Margin="0,0,0,6"/><TextBox x:Name="DriveClientIdBox" Margin="0,0,0,12"/><TextBlock Text="Client secret (optional)" Margin="0,0,0,6"/><PasswordBox x:Name="DriveClientSecretBox" Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextBrush}" Padding="12,9" Margin="0,0,0,12"/>
                                <TextBlock x:Name="DriveSettingsStatus" Text="Not connected" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,0,6"/><TextBlock x:Name="DriveBackupInfoText" Text="Backup details will appear after connection." Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
                                <WrapPanel><Button Content="Sign in with Google" Style="{StaticResource PrimaryButton}" Click="DriveSignIn_Click" Margin="0,0,8,8"/><Button Content="Sync now" Click="DriveSync_Click" Margin="0,0,8,8"/><Button Content="Disconnect" Click="DriveDisconnect_Click" Margin="0,0,8,8"/></WrapPanel>
                                <Separator Margin="0,24"/><TextBlock Text="Catalog services" Style="{StaticResource SectionTitle}"/><TextBlock Text="RAWG provides games; TMDB provides film and TV metadata; OMDb provides current IMDb ratings." Style="{StaticResource MutedText}" Margin="0,7,0,14"/>
                                <TextBlock Text="RAWG API key" Margin="0,0,0,6"/><PasswordBox x:Name="RawgKeyBox" Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextBrush}" Padding="12,9" Margin="0,0,0,10"/><TextBlock Text="TMDB API key" Margin="0,0,0,6"/><PasswordBox x:Name="TmdbKeyBox" Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextBrush}" Padding="12,9" Margin="0,0,0,10"/><TextBlock Text="OMDb API key" Margin="0,0,0,6"/><PasswordBox x:Name="OmdbKeyBox" Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextBrush}" Padding="12,9" Margin="0,0,0,12"/><Button Content="Save catalog keys" Style="{StaticResource PrimaryButton}" Click="SaveApiKeys_Click" HorizontalAlignment="Left"/>
                            </StackPanel></Border></ScrollViewer>
                        </TabItem>
                        <TabItem Header="Services">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource SurfaceCard}" Margin="18,0,0,0" MaxWidth="820"><StackPanel>
                                <TextBlock Text="Plex Media Server" FontSize="22" FontWeight="Bold"/><TextBlock Text="Deleting media always requires an explicit confirmation." Style="{StaticResource MutedText}" Margin="0,7,0,14"/><TextBlock Text="Plex server URL" Margin="0,0,0,6"/><TextBox x:Name="PlexUrlBox" Margin="0,0,0,10"/><TextBlock Text="X-Plex-Token" Margin="0,0,0,6"/><PasswordBox x:Name="PlexTokenBox" Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextBrush}" Padding="12,9" Margin="0,0,0,12"/><Button Content="Save and test Plex" Style="{StaticResource PrimaryButton}" Click="SavePlex_Click" HorizontalAlignment="Left"/>
                                <Separator Margin="0,24"/><TextBlock Text="BiglyBT native dashboard" Style="{StaticResource SectionTitle}"/><TextBlock Text="Use the secure HTTPS gateway. The saved session is device-specific." Style="{StaticResource MutedText}" Margin="0,7,0,14"/><TextBlock Text="Secure gateway URL" Margin="0,0,0,6"/><TextBox x:Name="BiglyEndpointBox" Margin="0,0,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Username" Margin="0,0,0,6"/><TextBox x:Name="BiglyUserBox"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Password" Margin="0,0,0,6"/><PasswordBox x:Name="BiglyPasswordBox" Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextBrush}" Padding="12,9"/></StackPanel></Grid><WrapPanel Margin="0,12,0,0"><Button Content="Sign in and save session" Style="{StaticResource PrimaryButton}" Click="BiglySignIn_Click" Margin="0,0,8,8"/><Button Content="Forget session" Click="BiglyDisconnect_Click" Margin="0,0,8,8"/></WrapPanel><CheckBox x:Name="BiglyAutoRemoveBox" Content="Automatically remove completed torrents and keep downloaded files" Margin="0,8,0,0" Checked="BiglyAutoRemove_Changed" Unchecked="BiglyAutoRemove_Changed"/>
                            </StackPanel></Border></ScrollViewer>
                        </TabItem>
                        <TabItem Header="Backup and recovery">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource SurfaceCard}" Margin="18,0,0,0" MaxWidth="820"><StackPanel>
                                <TextBlock Text="Backup and recovery" FontSize="22" FontWeight="Bold"/><TextBlock Text="Atomic saves and local snapshots protect the native vault before imports and edits." Style="{StaticResource MutedText}" Margin="0,7,0,18"/>
                                <WrapPanel><Button Content="Import backup" Style="{StaticResource PrimaryButton}" Click="Import_Click" Margin="0,0,8,8"/><Button Content="Export backup" Click="Export_Click" Margin="0,0,8,8"/><Button Content="Create snapshot" Click="CreateSnapshot_Click" Margin="0,0,8,8"/><Button Content="Open recovery" Click="OpenRecovery_Click" Margin="0,0,8,8"/></WrapPanel>
                                <Separator Margin="0,24"/><TextBlock Text="Diagnostics" Style="{StaticResource SectionTitle}"/><TextBlock Text="The diagnostic export contains app state and errors, never passwords, tokens, library titles, or health records." Style="{StaticResource MutedText}" Margin="0,7,0,14"/><Button Content="Export private diagnostics" Click="ExportDiagnostics_Click" HorizontalAlignment="Left"/>
                            </StackPanel></Border></ScrollViewer>
                        </TabItem>
                        <TabItem Header="About">
                            <Border Style="{StaticResource SurfaceCard}" Margin="18,0,0,0" MaxWidth="820" VerticalAlignment="Top"><StackPanel>
                                <TextBlock Text="Sinu Game Vault for Windows" FontSize="24" FontWeight="Bold"/><TextBlock Text="Version 2.0.3 · Native Windows edition" Foreground="{DynamicResource AccentBrush}" Margin="0,6,0,18"/><TextBlock Text="Version 2.0 introduces the responsive library shell, activity history, recovery center, cached online catalogs, categorized settings, stronger keyboard navigation, diagnostics, and the redesigned Home and details experience." TextWrapping="Wrap" LineHeight="23"/><Button Content="Check GitHub for updates" Margin="0,22,0,0" HorizontalAlignment="Left" Click="CheckUpdates_Click"/>
                            </StackPanel></Border>
                        </TabItem>
                    </TabControl>
                </Grid>

                <Border x:Name="DetailsPage" Visibility="Collapsed" Background="{DynamicResource DetailsBrush}" Panel.ZIndex="20" Padding="34">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Image x:Name="DetailBackdrop" Grid.RowSpan="2" Stretch="UniformToFill" Opacity="0.13" IsHitTestVisible="False"/>
                        <Border Grid.RowSpan="2" Background="{DynamicResource BackdropScrimBrush}" IsHitTestVisible="False"/>
                        <Button Content="X" Width="44" Height="44" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                FontSize="17" FontWeight="Bold" Click="CloseDetails_Click" Panel.ZIndex="3"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                            <Grid MaxWidth="1180" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="280" Height="420" Background="{DynamicResource PanelRaisedBrush}" CornerRadius="8" ClipToBounds="True" VerticalAlignment="Top">
                                    <Grid><TextBlock Text="GV" FontSize="48" FontWeight="Bold" Foreground="#30445E" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="DetailPoster" Stretch="UniformToFill"/></Grid>
                                </Border>
                                <Border Grid.Column="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="24" CornerRadius="8">
                                <StackPanel>
                                    <TextBlock x:Name="DetailType" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="12"/>
                                    <TextBlock x:Name="DetailTitle" FontSize="34" FontWeight="Bold" TextWrapping="Wrap" Margin="0,8,0,5"/>
                                    <TextBlock x:Name="DetailMeta" Foreground="{DynamicResource MutedBrush}" FontSize="14" TextWrapping="Wrap"/>
                                    <WrapPanel Margin="0,18,0,6">
                                        <Border Background="#332B2512" BorderBrush="#75652E" BorderThickness="1" CornerRadius="6" Padding="12,7" Margin="0,0,8,8"><TextBlock x:Name="DetailRating" Foreground="#FFD166" FontWeight="Bold"/></Border>
                                        <Border Background="#12362F" BorderBrush="#277A65" BorderThickness="1" CornerRadius="6" Padding="12,7" Margin="0,0,8,8"><TextBlock x:Name="DetailCountdown" Foreground="#76E6C2" FontWeight="Bold"/></Border>
                                        <Border x:Name="DetailEpisodesBadge" Background="#17253A" BorderBrush="#31577D" BorderThickness="1" CornerRadius="6" Padding="12,7" Margin="0,0,8,8"><TextBlock x:Name="DetailEpisodes" Foreground="#EAF3FF"/></Border>
                                    </WrapPanel>
                                    <TextBlock Text="STORY / SUMMARY" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="12" Margin="0,18,0,8"/>
                                    <TextBlock x:Name="DetailOverview" FontSize="15" LineHeight="24" TextWrapping="Wrap" MaxWidth="820"/>
                                    <TextBlock Text="AVAILABILITY" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="12" Margin="0,22,0,7"/>
                                    <TextBlock x:Name="DetailAvailability" Foreground="{DynamicResource MutedBrush}" FontSize="14" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="DetailNote" Foreground="{DynamicResource MutedBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,14,0,0"/>
                                    <WrapPanel x:Name="EpisodePicker" Visibility="Collapsed" Margin="0,18,0,0"><TextBlock Text="Season" VerticalAlignment="Center" Margin="0,0,7,0"/><ComboBox x:Name="DetailSeasonBox" Width="110" SelectionChanged="DetailSeason_Changed"/><TextBlock Text="Episode" VerticalAlignment="Center" Margin="14,0,7,0"/><ComboBox x:Name="DetailEpisodeBox" Width="120" SelectionChanged="DetailEpisode_Changed"/><Button Content="Load episode plot" Margin="10,0,0,0" Click="EpisodePlot_Click"/></WrapPanel>
                                    <WrapPanel Margin="0,16,0,0"><TextBlock Text="My rating" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="PersonalRatingBox" Width="100"><ComboBoxItem Content="Not rated" Tag="0"/><ComboBoxItem Content="1 / 10" Tag="1"/><ComboBoxItem Content="2 / 10" Tag="2"/><ComboBoxItem Content="3 / 10" Tag="3"/><ComboBoxItem Content="4 / 10" Tag="4"/><ComboBoxItem Content="5 / 10" Tag="5"/><ComboBoxItem Content="6 / 10" Tag="6"/><ComboBoxItem Content="7 / 10" Tag="7"/><ComboBoxItem Content="8 / 10" Tag="8"/><ComboBoxItem Content="9 / 10" Tag="9"/><ComboBoxItem Content="10 / 10" Tag="10"/></ComboBox><Button Content="Save rating" Margin="8,0,0,0" Click="SaveRating_Click"/></WrapPanel>
                                    <WrapPanel Margin="0,26,0,0">
                                        <Button Content="Watch trailer" Style="{StaticResource PrimaryButton}" Click="Trailer_Click" Margin="0,0,8,8"/>
                                        <Button Content="IMDb" Click="Imdb_Click" Margin="0,0,8,8"/>
                                        <Button Content="Wikipedia" Click="Wikipedia_Click" Margin="0,0,8,8"/>
                                        <Button Content="Google search" Click="Google_Click" Margin="0,0,8,8"/>
                                        <Button Content="IGN review" Click="IgnReview_Click" Margin="0,0,8,8"/>
                                        <Button Content="Reeload Media review" Click="ReeloadReview_Click" Margin="0,0,8,8"/>
                                        <Button x:Name="FandomButton" Content="Fandom" Click="Fandom_Click" Margin="0,0,8,8"/>
                                        <Button Content="AI assistant" Click="AiAssistant_Click" Margin="0,0,8,8"/>
                                        <Button x:Name="VendorLinksButton" Content="Rental vendors" Click="VendorLinks_Click" Margin="0,0,8,8"/>
                                        <Button Content="Edit details" Click="EditSelected_Click" Margin="0,0,8,8"/>
                                        <Button Content="Change status" Click="ChangeStatus_Click" Margin="0,0,8,8"/>
                                        <Button x:Name="DetailMoveButton" Content="Mark watched" Click="MoveStatus_Click" Margin="0,0,8,8"/>
                                        <Button x:Name="DetailRemoveButton" Content="Remove" Foreground="#FF93A0" Click="RemoveDetail_Click" Margin="0,0,8,8"/>
                                    </WrapPanel>
                                    <WrapPanel x:Name="MalayalamReviewButtons" Visibility="Collapsed"><Button Content="Monsoon Media review" Click="MonsoonReview_Click" Margin="0,0,8,8"/><Button Content="Aswanth Kok review" Click="AswanthReview_Click" Margin="0,0,8,8"/></WrapPanel>
                                </StackPanel>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" Background="{DynamicResource RailBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="28,0">
                <Grid><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="StatusText" Text="Ready" Style="{StaticResource MutedText}" VerticalAlignment="Center"/><Button x:Name="UndoButton" Content="Undo" Style="{StaticResource QuietButton}" Padding="10,3" MinHeight="26" Margin="12,0,0,0" Visibility="Collapsed" Click="Undo_Click"/></StackPanel><TextBlock Text="Sinu Game Vault for Windows" Style="{StaticResource MutedText}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
