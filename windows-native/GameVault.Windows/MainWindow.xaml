<Window x:Class="SinuGameVault.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:SinuGameVault.Services"
        Title="Sinu Game Vault" Icon="Assets/GameVault.ico" Width="1440" Height="900" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown" SizeChanged="Window_SizeChanged">
    <Window.Resources>
        <app:ArtworkHeightConverter x:Key="ArtworkHeight"/>
        <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="LibraryTileWidth">248</sys:Double>
        <DataTemplate x:Key="DashboardRowTemplate">
            <Button Tag="{Binding}" Click="LibraryCard_Click" Padding="0" Margin="0,0,0,10" Height="86"
                    Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource PanelRaisedBrush}" CornerRadius="8,0,0,8" ClipToBounds="True">
                        <Grid Background="{Binding PlaceholderColor}"><TextBlock Text="{Binding Initials}" Foreground="#7AFFFFFF" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image app:Artwork.Url="{Binding Image}" app:Artwork.DecodeWidth="120" Stretch="UniformToFill"/></Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="15,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding DetailMeta}" Foreground="{DynamicResource MutedBrush}" FontSize="14" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="12,0,16,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding DaysText}" Foreground="{Binding CountdownColor}" FontWeight="Bold" FontSize="19" Margin="0,5,0,0" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="LibraryCardTemplate">
            <!-- The art frame takes its height from the row so 2:3 posters and 16:9
                 game art each fill their own frame exactly, instead of one fixed
                 box cropping landscape art down to its middle third. -->
            <Button Tag="{Binding}" Click="LibraryCard_Click" Padding="0" Margin="0,0,16,20" Width="{DynamicResource LibraryTileWidth}"
                    Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Effect" Value="{StaticResource CardShadow}" />
                        <Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="0"/></Setter.Value></Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Effect" Value="{StaticResource RaisedShadow}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="RenderTransform"><Setter.Value><TranslateTransform Y="-3"/></Setter.Value></Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Button.ContextMenu><ContextMenu><MenuItem Header="Open details" Tag="open" Click="CardQuickAction_Click"/><MenuItem Header="Edit details" Tag="edit" Click="CardQuickAction_Click"/><Separator/><MenuItem Header="Primary action" Tag="primary" Click="CardQuickAction_Click"/><MenuItem Header="Add to watchlist / queue" Tag="watchlist" Click="CardQuickAction_Click"/><MenuItem Header="Mark watched / completed" Tag="watched" Click="CardQuickAction_Click"/><MenuItem Header="Not interested" Tag="hidden" Click="CardQuickAction_Click"/></ContextMenu></Button.ContextMenu>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="{Binding PlaceholderColor}" CornerRadius="8,8,0,0" ClipToBounds="True">
                        <Border.Height><MultiBinding Converter="{StaticResource ArtworkHeight}"><Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Button}"/><Binding Path="IsPortraitArt"/></MultiBinding></Border.Height>
                        <Grid>
                            <!-- Drawn locally so a title without a cover is never a blank card. -->
                            <TextBlock Text="{Binding Initials}" FontSize="44" FontWeight="Bold" Foreground="#66FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image app:Artwork.Url="{Binding Image}" app:Artwork.DecodeWidth="320" Stretch="{Binding ArtStretch}" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <!-- Stacked rather than left/right: on a 236px card the two
                                 pills sat shoulder to shoulder and visibly collided. -->
                            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10">
                                <Border HorizontalAlignment="Left" Background="{Binding CategoryColor}" CornerRadius="4" Padding="9,5"><TextBlock Text="{Binding CategoryLabel}" Foreground="White" FontSize="12" FontWeight="SemiBold" MaxWidth="180" TextTrimming="CharacterEllipsis"/></Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="1" Margin="14,12,14,14">
                        <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" FontWeight="SemiBold" FontSize="18" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Height="72" LineHeight="24"/>
                        <TextBlock Text="{Binding PrimaryMeta}" Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding CardRatingText}" Foreground="{DynamicResource WarningBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0" Height="18"/>
                        <TextBlock Text="{Binding Date}" Foreground="{DynamicResource AccentBrush}" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Visibility="{Binding HasCountdown, Converter={StaticResource BoolToVisibility}}" Margin="0,10,0,0">
                            <TextBlock Text="{Binding DaysText}" Foreground="{DynamicResource TextBrush}" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <ProgressBar Value="{Binding PeriodRemainingPercent, Mode=OneWay}" Maximum="100" Height="4" Margin="0,8,0,0" Foreground="{Binding PeriodColor}" Background="{DynamicResource DividerBrush}" BorderThickness="0" Visibility="{Binding HasPeriod, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                        <!-- The obvious next step, without opening the title first. -->
                        <Button Content="{Binding QuickActionLabel}" Tag="{Binding}" Click="CardQuickButton_Click"
                                Visibility="{Binding HasQuickAction, Converter={StaticResource BoolToVisibility}}"
                                Margin="0,14,0,0" Padding="10,6" MinHeight="38" FontSize="13" FontWeight="SemiBold"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="LibraryListTemplate">
            <Button Tag="{Binding}" Click="LibraryCard_Click" Padding="0" Margin="0,0,0,10" Height="104"
                    Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" HorizontalContentAlignment="Stretch">
                <Button.ContextMenu><ContextMenu><MenuItem Header="Open details" Tag="open" Click="CardQuickAction_Click"/><MenuItem Header="Edit details" Tag="edit" Click="CardQuickAction_Click"/><Separator/><MenuItem Header="Primary action" Tag="primary" Click="CardQuickAction_Click"/><MenuItem Header="Add to watchlist / queue" Tag="watchlist" Click="CardQuickAction_Click"/><MenuItem Header="Mark watched / completed" Tag="watched" Click="CardQuickAction_Click"/><MenuItem Header="Not interested" Tag="hidden" Click="CardQuickAction_Click"/></ContextMenu></Button.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource PanelRaisedBrush}" CornerRadius="8,0,0,8" ClipToBounds="True"><Grid Background="{Binding PlaceholderColor}"><TextBlock Text="{Binding Initials}" Foreground="#7AFFFFFF" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image app:Artwork.Url="{Binding Image}" app:Artwork.DecodeWidth="140" Stretch="UniformToFill"/></Grid></Border>
                    <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="18" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding DetailMeta}" Foreground="{DynamicResource MutedBrush}" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center"><Border HorizontalAlignment="Left" Background="{Binding CategoryColor}" CornerRadius="5" Padding="8,4"><TextBlock Text="{Binding CategoryLabel}" Foreground="White" FontSize="11" FontWeight="Bold"/></Border><TextBlock Text="{Binding CardStatusText}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                    <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0"><TextBlock Text="{Binding CardRatingText}" Foreground="{DynamicResource WarningBrush}" FontWeight="Bold"/><TextBlock Text="{Binding DaysText}" Foreground="{Binding CountdownColor}" FontWeight="Bold" FontSize="19" Margin="0,4,0,0"/></StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
    </Window.Resources>
    <Grid Background="{DynamicResource WindowBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="RailColumn" Width="228"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <!-- Layered background: section artwork, a scrim to keep text legible,
             then an ambient glow and a faint weave so large empty regions have
             some depth instead of reading as one flat colour. -->
        <Image x:Name="SectionBackdrop" Grid.ColumnSpan="2" Stretch="UniformToFill" Opacity="0.16" IsHitTestVisible="False"/>
        <Border Grid.ColumnSpan="2" Background="{DynamicResource BackdropScrimBrush}" IsHitTestVisible="False"/>
        <Border x:Name="AuroraLayer" Grid.ColumnSpan="2" Background="{StaticResource AuroraBrush}" IsHitTestVisible="False"/>
        <Border x:Name="AuroraLayerTwo" Grid.ColumnSpan="2" Background="{StaticResource AuroraSecondaryBrush}" IsHitTestVisible="False"/>
        <Border x:Name="PatternLayer" Grid.ColumnSpan="2" Background="{StaticResource PatternBrush}" Opacity="0.35" IsHitTestVisible="False"/>
        <Border x:Name="VignetteLayer" Grid.ColumnSpan="2" Background="{StaticResource VignetteBrush}" IsHitTestVisible="False"/>

        <Border Background="{DynamicResource RailBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,22">
                <StackPanel x:Name="RailNavigation" DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="6,0,0,22">
                        <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource AccentGradientBrush}" Effect="{StaticResource CardShadow}">
                            <TextBlock Text="GV" Foreground="#06101A" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="SINU GAME VAULT" FontSize="13" FontWeight="Bold" />
                            <TextBlock Text="Private library" Style="{StaticResource MutedText}" FontSize="11" Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="LIBRARY" Style="{StaticResource KickerText}" Margin="16,0,0,4"/>
                    <Button x:Name="HomeRailButton" Tag="Overview" Style="{StaticResource RailButton}" Click="Navigate_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="⌂" FontSize="16" Width="26"/><TextBlock Text="Home"/></StackPanel>
                    </Button>
                    <Button x:Name="GamesRailButton" Tag="Games" Style="{StaticResource RailButton}" Click="Navigate_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="▣" FontSize="15" Width="26"/><TextBlock Text="Games"/><TextBlock x:Name="GamesRailCount" Foreground="{DynamicResource MutedBrush}" FontSize="11" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button x:Name="MoviesRailButton" Tag="Movies" Style="{StaticResource RailButton}" Click="Navigate_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="◉" FontSize="15" Width="26"/><TextBlock Text="Movies"/><TextBlock x:Name="MoviesRailCount" Foreground="{DynamicResource MutedBrush}" FontSize="11" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button x:Name="SeriesRailButton" Tag="Series" Style="{StaticResource RailButton}" Click="Navigate_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="▤" FontSize="15" Width="26"/><TextBlock Text="TV Shows"/><TextBlock x:Name="SeriesRailCount" Foreground="{DynamicResource MutedBrush}" FontSize="11" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="14,14,6,14" Opacity="0.6"/>
                    <TextBlock Text="SERVICES" Style="{StaticResource KickerText}" Margin="16,0,0,4"/>
                    <Button Tag="Plex" Style="{StaticResource RailButton}" Click="Navigate_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="▶" FontSize="14" Width="26"/><TextBlock Text="Plex"/></StackPanel>
                    </Button>
                    <Button Tag="BiglyBT" Style="{StaticResource RailButton}" Click="Navigate_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="⇩" FontSize="15" Width="26"/><TextBlock Text="BiglyBT"/></StackPanel>
                    </Button>
                    <Button Tag="Petrol" Style="{StaticResource RailButton}" Click="Navigate_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="⛽" FontSize="15" Width="26"/><TextBlock Text="Petrol"/></StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel x:Name="RailFooter" DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="14,0,6,12" Opacity="0.6"/>
                    <Button Tag="Settings" Style="{StaticResource RailButton}" Click="Navigate_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="⚙" FontSize="15" Width="26"/><TextBlock Text="Settings"/></StackPanel>
                    </Button>
                    <TextBlock x:Name="VersionText" Style="{StaticResource MutedText}" FontSize="11" Margin="16,10,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="84"/><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
            <Border Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="28,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel x:Name="PageHeading" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock x:Name="PageTitle" Text="Overview" FontSize="25" FontWeight="Bold" />
                        <TextBlock x:Name="PageSubtitle" Text="Your library at a glance" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="FeaturedTitleText" Text="" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                        <TextBlock x:Name="DriveHeaderStatus" Text="Drive offline" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <Grid Margin="0,0,10,0">
                            <TextBox x:Name="SearchBox" Width="260" Padding="32,9,32,9" AutomationProperties.Name="Search current tab" ToolTip="Search the current tab (Ctrl+K)" TextChanged="SearchBox_TextChanged" />
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource MutedBrush}"/>
                            <TextBlock Text="Search titles" Margin="32,0,32,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource MutedBrush}">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <Button Click="ClearSearch_Click" Width="28" MinHeight="28" Padding="0" Margin="0,0,4,0" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Clear search" AutomationProperties.Name="Clear search">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource QuietButton}"><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                            </Button>
                        </Grid>
                        <Button x:Name="ThemeButton" Content="Light mode" Margin="0,0,8,0" Click="Theme_Click"/>
                        <Button Content="Refresh" Click="GlobalRefresh_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="28,22">
                <ScrollViewer x:Name="OverviewPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="24"/><RowDefinition Height="Auto"/><RowDefinition Height="24"/><RowDefinition Height="Auto"/><RowDefinition Height="24"/><RowDefinition Height="Auto"/><RowDefinition Height="24"/><RowDefinition Height="Auto"/><RowDefinition Height="24"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Pick up where you left off" FontSize="30" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Text, ElementName=HomeSummaryText}" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,24"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel><DockPanel Margin="0,0,0,14"><Button Content="View all" Tag="Games" Click="HomeShortcut_Click" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource QuietButton}"/><TextBlock Text="Continue playing" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><ItemsControl x:Name="HomeContinuePlaying" ItemTemplate="{StaticResource DashboardRowTemplate}"/><TextBlock x:Name="HomePlayingEmpty" Text="Your active games will appear here." Foreground="{DynamicResource MutedBrush}" Margin="0,12"/></StackPanel>
                            <StackPanel Grid.Column="2"><DockPanel Margin="0,0,0,14"><Button Content="View all" Tag="Movies" Click="HomeWatching_Click" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource QuietButton}"/><TextBlock Text="Continue watching" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><ItemsControl x:Name="HomeContinueWatching" ItemTemplate="{StaticResource DashboardRowTemplate}"/><TextBlock x:Name="HomeWatchingEmpty" Text="Movies and shows you are watching will appear here." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,12"/></StackPanel>
                        </Grid>
                    </StackPanel>
                    <Border Style="{StaticResource SurfaceCard}" Padding="26" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="YOUR LIBRARY TODAY" Style="{StaticResource KickerText}"/>
                                <TextBlock Text="Pick up where you stopped." FontSize="28" FontWeight="Bold" Margin="0,7,0,4"/>
                                <TextBlock x:Name="HomeSummaryText" Text="Rentals, watchlists and upcoming releases are ready." Style="{StaticResource MutedText}"/>
                                <!-- Days since the last fill, big enough to read at a glance. -->
                                <Border Background="#1F4CC9F0" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18,12" Margin="0,14,0,0" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⛽" FontSize="34" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock x:Name="PetrolHomeDays" Text="--" FontSize="40" FontWeight="Bold" LineHeight="42"/>
                                            <TextBlock x:Name="PetrolHomeCaption" Text="no refills logged yet" Style="{StaticResource MutedText}" FontSize="11"/>
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="PETROL" Style="{StaticResource KickerText}"/>
                                            <TextBlock x:Name="PetrolHomeSummary" Text="Honda Activa" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="26,0,0,0">
                                <Button Content="Now playing" Tag="Games" Style="{StaticResource PrimaryButton}" Click="HomeShortcut_Click" Margin="0,0,8,8"/>
                                <Button Content="Movie watchlist" Tag="Movies" Click="HomeShortcut_Click" Margin="0,0,8,8"/>
                                <Button Content="Sync Drive" Click="DriveSync_Click" Margin="0,0,0,8"/>
                            </WrapPanel>
                        </Grid>
                    </Border>
                    <UniformGrid x:Name="OverviewStats" Grid.Row="6" Columns="6">
                        <Border Style="{StaticResource SurfaceCard}" Padding="18" Margin="0,0,8,0">
                            <StackPanel><TextBlock Text="ACTIVE RENTALS" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="12"/><TextBlock x:Name="RentalCount" Text="0" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock Text="games currently rented" Style="{StaticResource MutedText}"/></StackPanel>
                        </Border>
                        <Border Style="{StaticResource SurfaceCard}" Padding="18" Margin="4,0,4,0">
                            <StackPanel><TextBlock Text="NOW PLAYING" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="12"/><TextBlock x:Name="PlayingCount" Text="0" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock Text="active games" Style="{StaticResource MutedText}"/></StackPanel>
                        </Border>
                        <Border Style="{StaticResource SurfaceCard}" Padding="18" Margin="4,0,4,0">
                            <StackPanel><TextBlock Text="WATCHLIST" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="12"/><TextBlock x:Name="WatchlistCount" Text="0" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock Text="movies and TV shows" Style="{StaticResource MutedText}"/></StackPanel>
                        </Border>
                        <Border Style="{StaticResource SurfaceCard}" Padding="18" Margin="4,0,4,0">
                            <StackPanel><TextBlock Text="COMPLETED" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="12"/><TextBlock x:Name="CompletedCount" Text="0" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock Text="games finished" Style="{StaticResource MutedText}"/></StackPanel>
                        </Border>
                        <Border Style="{StaticResource SurfaceCard}" Padding="18" Margin="4,0,4,0"><StackPanel><TextBlock Text="TOTAL RENTED" Foreground="#A45BDD" FontWeight="Bold" FontSize="12"/><TextBlock x:Name="TotalRentedCount" Text="0" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock Text="all rental periods" Style="{StaticResource MutedText}"/></StackPanel></Border>
                        <Border Style="{StaticResource SurfaceCard}" Padding="18" Margin="4,0,0,0"><StackPanel><TextBlock Text="TOTAL SPENT" Foreground="#C28A00" FontWeight="Bold" FontSize="12"/><TextBlock x:Name="TotalSpentCount" Text="₹0" FontSize="24" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock Text="rentals + subscriptions" Style="{StaticResource MutedText}"/></StackPanel></Border>
                    </UniformGrid>
                    <Border Grid.Row="8" Style="{StaticResource SurfaceCard}" Padding="0,20" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Top">
                                <TextBlock Text="GAME SPENDING" Style="{StaticResource KickerText}"/>
                                <TextBlock Text="Last 12 months" FontSize="20" FontWeight="Bold" Margin="0,5,0,3"/>
                                <TextBlock Text="Each bar is a month, split by vendor" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                                <!-- Legend: vendor name, its colour and 12-month total. -->
                                <ItemsControl x:Name="SpendChartLegend" Margin="0,12,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,5">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <Border Width="11" Height="11" CornerRadius="3" Background="{Binding ToneColor}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding AmountText}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <ItemsControl x:Name="GameSpendChart" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,0">
                                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <!-- One stacked column: a coloured section per vendor. -->
                                            <Border Grid.Row="0" Width="28" VerticalAlignment="Bottom" HorizontalAlignment="Center" CornerRadius="4,4,0,0" ClipToBounds="True">
                                                <ItemsControl ItemsSource="{Binding Segments}" VerticalAlignment="Bottom">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Height="{Binding Height}" Background="{Binding ColorHex}" ToolTip="{Binding Tip}"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                            <TextBlock Grid.Row="1" Text="{Binding AmountText}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            <TextBlock Grid.Row="2" Text="{Binding Month}" FontSize="10" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                    <!-- Petrol refills per month, on their own timeline. -->
                    <Border Grid.Row="10" Style="{StaticResource SurfaceCard}" Padding="0,20" Margin="0,0,0,18" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="PETROL REFILLS" Style="{StaticResource KickerText}"/>
                                <TextBlock Text="Last 12 months" FontSize="20" FontWeight="Bold" Margin="0,5,0,3"/>
                                <TextBlock x:Name="PetrolChartHint" Text="How often the Activa was filled" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ItemsControl x:Name="PetrolChart" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,0">
                                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <Border Grid.Row="0" Width="28" Height="{Binding BarHeight}" MinHeight="3" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                                    CornerRadius="4,4,0,0" Background="{DynamicResource SuccessBrush}" ToolTip="{Binding Tip}"/>
                                            <TextBlock Grid.Row="1" Text="{Binding CountText}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            <TextBlock Grid.Row="2" Text="{Binding Month}" FontSize="10" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="4"><TextBlock Text="On the horizon" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,14"/><ItemsControl x:Name="HomeUpcoming" ItemTemplate="{StaticResource DashboardRowTemplate}"/><TextBlock x:Name="HomeUpcomingEmpty" Text="Upcoming titles will appear after refreshing your release catalogs." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/></StackPanel>
                    <Grid Grid.Row="2" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <!-- Every rental return and subscription renewal, soonest first.
                             Both panels hug their content and only grow to the height the
                             row can give them, so a short list does not leave the bottom
                             half of the page empty while a long one still scrolls. -->
                        <Border Style="{StaticResource SurfaceCard}" VerticalAlignment="Top">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Due dates" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock x:Name="DueDatesSubtitle" Text="Rental returns and subscription renewals." Style="{StaticResource MutedText}" Margin="0,5,0,14"/>
                                </StackPanel>
                                <!-- A grid rather than a single column: the panel is wide, so
                                     due dates read faster side by side than stacked. -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="DueDatesList">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel HorizontalAlignment="Left"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- Title card: artwork on the left, then the title, the
                                                     rental/subscription type, the vendor and the due date. -->
                                                <Border Width="300" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                                        CornerRadius="12" Margin="0,0,10,10" ClipToBounds="True" Effect="{StaticResource CardShadow}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Width="94" Background="{Binding PlaceholderColor}" ClipToBounds="True">
                                                            <Grid>
                                                                <TextBlock Text="{Binding Initials}" FontSize="24" FontWeight="Bold" Foreground="#66FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                <Image app:Artwork.Url="{Binding Image}" app:Artwork.DecodeWidth="150" Stretch="UniformToFill"/>
                                                            </Grid>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="13,11">
                                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                                            <Border HorizontalAlignment="Left" Background="#22FFFFFF" CornerRadius="4" Padding="6,2" Margin="0,5,0,0">
                                                                <TextBlock Text="{Binding Kind}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding VendorLine}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"
                                                                       Visibility="{Binding HasVendorLine, Converter={StaticResource BoolToVisibility}}"/>
                                                            <TextBlock Text="{Binding DueText}" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="Bold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding Countdown}" Foreground="{Binding ToneColor}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Margin="8,0,14,0"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource SurfaceCard}" VerticalAlignment="Top">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Where the money went" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Spending by vendor and subscription." Style="{StaticResource MutedText}" Margin="0,5,0,12"/>
                                </StackPanel>
                                <!-- Donut: each vendor/subscription is one arc. -->
                                <Grid Grid.Row="1" Height="176" HorizontalAlignment="Center">
                                    <Canvas x:Name="SpendDonut" Width="176" Height="176"/>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock x:Name="SpendDonutTotal" Text="₹0" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="total spent" Style="{StaticResource MutedText}" FontSize="11" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Grid.Row="2" x:Name="SpendLegendHint" Text="Select a vendor to open its website." Style="{StaticResource MutedText}" FontSize="11" Margin="0,12,0,8"/>
                                <ItemsControl Grid.Row="3" x:Name="SpendLegend">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Tag="{Binding}" Click="VendorSpend_Click" Padding="8,7" Margin="0,0,0,5"
                                                    Background="Transparent" BorderBrush="Transparent" HorizontalContentAlignment="Stretch"
                                                    ToolTip="{Binding LinkHint}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <Border Width="11" Height="11" CornerRadius="3" Background="{Binding ToneColor}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding AmountText}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
                </ScrollViewer>

                <Grid x:Name="GamesPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <WrapPanel Grid.Column="0">
                            <ComboBox x:Name="LibrarySectionBox" Width="170" Margin="0,0,8,8" SelectionChanged="LibrarySection_Changed">
                                <ComboBoxItem Content="Rentals" Tag="rentals"/>
                                <ComboBoxItem Content="Subscriptions" Tag="subscriptionGames"/>
                                <ComboBoxItem Content="Purchased" Tag="purchasedGames"/>
                                <ComboBoxItem Content="Rental queue" Tag="queue"/>
                                <ComboBoxItem Content="Completed" Tag="played"/>
                            </ComboBox>
                            <ComboBox x:Name="GamePlatformBox" Width="160" SelectedIndex="0" Visibility="Collapsed" Margin="0,0,8,8" SelectionChanged="GamePlatform_Changed" AutomationProperties.Name="Game platform">
                                <ComboBoxItem Content="PlayStation 5" Tag="ps5"/><ComboBoxItem Content="Xbox and PC" Tag="xboxpc"/>
                            </ComboBox>
                            <Button x:Name="AddGameButton" Content="Add game" Style="{StaticResource PrimaryButton}" Click="AddGame_Click" Margin="0,0,8,8"/>
                            <Button x:Name="GamesCategoryButton" Content="Group by year" Margin="0,0,8,8" Click="CategoryView_Click"/>
                            <Button Content="More" Margin="0,0,8,8" Click="OpenActionsMenu_Click"><Button.ContextMenu><ContextMenu>
                                <MenuItem Header="Edit selected title" Click="EditSelected_Click"/><MenuItem Header="Rental history" Click="RentalHistory_Click"/><MenuItem Header="Vendor report" Click="VendorReport_Click"/><MenuItem Header="Manage subscriptions" Click="ManageSubscriptions_Click"/><Separator/><MenuItem Header="Refresh online catalog" Click="RefreshOnline_Click"/>
                            </ContextMenu></Button.ContextMenu></Button>
                        </WrapPanel>
                        <StackPanel x:Name="GameToolbarOptions" Grid.Column="1" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Top">
                            <ComboBox x:Name="GameSortBox" Width="150" SelectionChanged="LibrarySort_Changed"><ComboBoxItem Content="Newest first" Tag="new"/><ComboBoxItem Content="Title A-Z" Tag="title"/><ComboBoxItem Content="Release date" Tag="date"/><ComboBoxItem Content="Rating" Tag="rating"/></ComboBox>
                            <Button x:Name="GameViewButton" Content="List view" Margin="8,0,0,0" Click="GameView_Click"/>
                            <Button Content="Density" ToolTip="Switch between comfortable and compact cards" Margin="8,0,0,0" Click="Density_Click"/>
                        </StackPanel>
                    </Grid>
                    <TabControl x:Name="GamesTabs" SelectionChanged="GamesTabs_SelectionChanged">
                        <TabItem Tag="library" app:TabAccent.Color="#1E9BE0"><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" FontSize="16" Margin="0,0,8,0"/><TextBlock Text="Library"/></StackPanel></TabItem.Header></TabItem>
                        <TabItem Tag="playing" app:TabAccent.Color="#16A97F"><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="16" Margin="0,0,8,0"/><TextBlock Text="Now Playing"/></StackPanel></TabItem.Header></TabItem>
                        <TabItem Tag="catalogExtra" app:TabAccent.Color="#4A78E0"><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="16" Margin="0,0,8,0"/><TextBlock Text="Discover"/></StackPanel></TabItem.Header></TabItem>
                        <TabItem Tag="upcoming" app:TabAccent.Color="#0070D1"><TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE787;" FontFamily="Segoe Fluent Icons" FontSize="16" Margin="0,0,8,0"/><TextBlock Text="Upcoming"/></StackPanel></TabItem.Header></TabItem>
                    </TabControl>
                    <ScrollViewer x:Name="GamesCardScroll" Grid.Row="6" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="CardScroll_ScrollChanged">
                        <ItemsControl x:Name="GamesCards" ItemTemplate="{StaticResource LibraryCardTemplate}">
                            <ItemsControl.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><Border Style="{StaticResource GroupDivider}"><TextBlock Text="{Binding Name}" FontSize="22" FontWeight="Bold"/></Border></DataTemplate></GroupStyle.HeaderTemplate><GroupStyle.Panel><ItemsPanelTemplate><StackPanel Orientation="Vertical"/></ItemsPanelTemplate></GroupStyle.Panel></GroupStyle></ItemsControl.GroupStyle>
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel HorizontalAlignment="Left"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                    <ListBox x:Name="GamesList" Grid.Row="6" Visibility="Collapsed" ItemTemplate="{StaticResource LibraryListTemplate}" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource PlainListItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.ScrollUnit="Pixel"><ListBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><Border Style="{StaticResource GroupDivider}"><TextBlock Text="{Binding Name}" FontSize="22" FontWeight="Bold"/></Border></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle></ListBox>
                </Grid>

                <Grid x:Name="MediaPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <WrapPanel x:Name="MediaTabsPanel"/>
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <WrapPanel Grid.Column="0">
                                <ComboBox x:Name="MediaBrowseBox" Width="210" Margin="0,0,8,8" SelectionChanged="MediaBrowse_Changed" AutomationProperties.Name="Library filter"/>
                                <Button Content="Add title" Style="{StaticResource PrimaryButton}" Click="AddMedia_Click" Margin="0,0,8,8"/>
                                <Button x:Name="MediaCategoryButton" Content="Group by year" Margin="0,0,8,8" Click="CategoryView_Click"/>
                                <Button Content="More" Margin="0,0,8,8" Click="OpenActionsMenu_Click"><Button.ContextMenu><ContextMenu><MenuItem Header="Edit selected title" Click="EditSelected_Click"/><MenuItem Header="Find a title online" Click="FindOnline_Click"/><MenuItem Header="Refresh this catalog" Click="RefreshOnline_Click"/></ContextMenu></Button.ContextMenu></Button>
                            </WrapPanel>
                            <StackPanel x:Name="MediaToolbarOptions" Grid.Column="1" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Top">
                                <ComboBox x:Name="MediaYearBox" Width="115" SelectionChanged="MediaFilter_Changed"><ComboBoxItem Content="All years" Tag=""/></ComboBox>
                                <TextBox x:Name="MediaGenreBox" Width="110" Margin="8,0,0,0" ToolTip="Filter by genre" AutomationProperties.Name="Genre filter" TextChanged="MediaGenre_TextChanged"/>
                                <ComboBox x:Name="MediaSortBox" Width="145" Margin="8,0,0,0" SelectionChanged="LibrarySort_Changed"><ComboBoxItem Content="Newest first" Tag="new"/><ComboBoxItem Content="Title A-Z" Tag="title"/><ComboBoxItem Content="Rating" Tag="rating"/></ComboBox>
                                <Button x:Name="MediaViewButton" Content="List view" Margin="8,0,0,0" Click="MediaView_Click"/>
                                <Button Content="Density" ToolTip="Switch between comfortable and compact cards" Margin="8,0,0,0" Click="Density_Click"/>
                            </StackPanel>
                    </Grid>
                    <ScrollViewer x:Name="MediaCardScroll" Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="CardScroll_ScrollChanged">
                        <ItemsControl x:Name="MediaCards" ItemTemplate="{StaticResource LibraryCardTemplate}">
                            <ItemsControl.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><Border Style="{StaticResource GroupDivider}"><TextBlock Text="{Binding Name}" FontSize="22" FontWeight="Bold"/></Border></DataTemplate></GroupStyle.HeaderTemplate><GroupStyle.Panel><ItemsPanelTemplate><StackPanel Orientation="Vertical"/></ItemsPanelTemplate></GroupStyle.Panel></GroupStyle></ItemsControl.GroupStyle>
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel HorizontalAlignment="Left"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                    <ListBox x:Name="MediaList" Grid.Row="4" Visibility="Collapsed" ItemTemplate="{StaticResource LibraryListTemplate}" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource PlainListItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.ScrollUnit="Pixel"><ListBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><Border Style="{StaticResource GroupDivider}"><TextBlock Text="{Binding Name}" FontSize="22" FontWeight="Bold"/></Border></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle></ListBox>
                </Grid>

                <Grid x:Name="PlaceholderPage" Visibility="Collapsed">
                    <Border Style="{StaticResource SurfaceCard}" Padding="32" MaxWidth="760" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock x:Name="PlaceholderTitle" Text="Integration" FontSize="24" FontWeight="Bold" />
                            <TextBlock x:Name="PlaceholderMessage" Text="This native integration is scheduled for a later phase." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="PlexPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel>
                        <WrapPanel x:Name="PlexModeTabs"><Button Content="Continue Watching" Tag="continue" Click="PlexMode_Click"/><Button Content="All Library" Tag="all" Margin="8,0,0,0" Click="PlexMode_Click"/><Button Content="Movies" Tag="movie" Margin="8,0,0,0" Click="PlexMode_Click"/><Button Content="TV Shows" Tag="show" Margin="8,0,0,0" Click="PlexMode_Click"/><Button Content="Recently Added" Tag="recent" Margin="8,0,0,0" Click="PlexMode_Click"/></WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><TextBlock x:Name="PlexStatusText" Text="Not connected" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Content="Refresh library" Click="PlexRefresh_Click"/></StackPanel>
                    </StackPanel>
                    <Border x:Name="PlexSetupPanel" Grid.Row="2" Style="{StaticResource SurfaceCard}" Padding="28" MaxWidth="760" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <StackPanel><TextBlock Text="Connect Plex Media Server" FontSize="24" FontWeight="Bold"/><TextBlock Text="Add the server URL and X-Plex-Token in Settings, then select Discover Plex library. Credentials stay in Windows Credential Manager." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,16"/><WrapPanel><Button Content="Open Settings" Tag="Settings" Style="{StaticResource PrimaryButton}" Click="Navigate_Click" Margin="0,0,8,0"/><Button Content="How to get X-Plex-Token" Click="PlexTokenHelp_Click"/></WrapPanel></StackPanel>
                    </Border>
                    <ScrollViewer x:Name="PlexLibraryScroll" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="PlexCards" ItemTemplate="{StaticResource LibraryCardTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel HorizontalAlignment="Left"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="BiglyPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="2*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <WrapPanel><Button Content="Paste and add magnet" Style="{StaticResource PrimaryButton}" Click="BiglyPaste_Click" Margin="0,0,8,8"/><Button Content="Refresh" Margin="0,0,8,8" Click="BiglyRefresh_Click"/><Button Content="Start" Margin="0,0,8,8" Click="BiglyStart_Click"/><Button Content="Pause" Margin="0,0,8,8" Click="BiglyStop_Click"/><Button Content="Remove (keep files)" Margin="0,0,8,8" Click="BiglyRemove_Click"/><Button Content="Delete files" Foreground="{DynamicResource DangerBrush}" Margin="0,0,8,8" Click="BiglyDelete_Click"/><ComboBox x:Name="BiglyPriorityBox" Width="110" Margin="0,0,8,8" SelectedIndex="0" SelectionChanged="BiglyPriority_Changed"><ComboBoxItem Content="Priority" Tag=""/><ComboBoxItem Content="High" Tag="1"/><ComboBoxItem Content="Normal" Tag="0"/><ComboBoxItem Content="Low" Tag="-1"/></ComboBox></WrapPanel>
                        <StackPanel Grid.Row="2" Orientation="Horizontal"><TextBlock x:Name="BiglyStatusText" Text="Not connected" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/></StackPanel>
                    </Grid>
                    <UniformGrid Grid.Row="2" Columns="3">
                        <Border Style="{StaticResource StatCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="ACTIVE" Style="{StaticResource StatLabel}"/><TextBlock x:Name="BiglyActiveCount" Text="0" Style="{StaticResource StatValue}"/></StackPanel></Border>
                        <Border Style="{StaticResource StatCard}" Margin="0,0,10,0"><StackPanel><TextBlock Text="TRANSFER SPEED" Style="{StaticResource StatLabel}"/><TextBlock x:Name="BiglyTransferSpeed" Text="0 B/s" Style="{StaticResource StatValue}"/></StackPanel></Border>
                        <Border Style="{StaticResource StatCard}"><StackPanel><TextBlock Text="DATA REMAINING" Style="{StaticResource StatLabel}"/><TextBlock x:Name="BiglyRemainingData" Text="0 B" Style="{StaticResource StatValue}"/></StackPanel></Border>
                    </UniformGrid>
                    <Border x:Name="BiglySetupPanel" Grid.Row="4" Style="{StaticResource SurfaceCard}" Padding="28" MaxWidth="760" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <StackPanel><TextBlock Text="Connect BiglyBT" FontSize="22" FontWeight="Bold"/><TextBlock Text="The native dashboard uses your secure Cloudflare gateway API. The endpoint and saved login remain in Windows Credential Manager." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,16"/><Button Content="Open Settings" Tag="Settings" Style="{StaticResource PrimaryButton}" Click="Navigate_Click" HorizontalAlignment="Left"/></StackPanel>
                    </Border>
                    <DataGrid x:Name="BiglyGrid" Grid.Row="4" Visibility="Collapsed" ItemsSource="{Binding}" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Torrent" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                            <!-- Visual progress bar with the percentage sitting on top,
                                 like the web dashboard, instead of a bare number. -->
                            <DataGridTemplateColumn Header="Progress" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Margin="4,4">
                                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Height="4"
                                                         Background="{DynamicResource PanelRaisedBrush}" BorderThickness="0"
                                                         Foreground="{DynamicResource AccentBrush}"/>
                                            <TextBlock Text="{Binding ProgressText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Downloaded / Total" Binding="{Binding AmountText}" Width="170"/>
                            <DataGridTextColumn Header="Speed" Binding="{Binding SpeedText}" Width="130"/>
                            <DataGridTextColumn Header="Time left" Binding="{Binding EtaText}" Width="90"/>
                            <DataGridTextColumn Header="Peers" Binding="{Binding Peers}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="6" Style="{StaticResource GroupDivider}"><TextBlock Text="Torrent History" FontSize="22" FontWeight="Bold"/></Border>
                    <DataGrid x:Name="BiglyHistoryGrid" Grid.Row="8" Visibility="Visible" IsReadOnly="True">
                        <DataGrid.Columns><DataGridTextColumn Header="Title" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Outcome" Binding="{Binding Outcome}" Width="210"/><DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="170"/><DataGridTextColumn Header="Progress" Binding="{Binding Progress}" Width="100"/><DataGridTextColumn Header="Downloaded" Binding="{Binding Downloaded}" Width="130"/><DataGridTextColumn Header="Files" Binding="{Binding Files}" Width="110"/></DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <Grid x:Name="PetrolPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <!-- Only the date is recorded. Everything shown is derived from it. -->
                    <Border Style="{StaticResource SurfaceCard}" Padding="22,18">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⛽" FontSize="26" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                                <TextBlock Text="LOG A REFILL" Style="{StaticResource KickerText}"/>
                                <TextBlock Text="Pick the day you filled up" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <DatePicker x:Name="PetrolDate" Width="170" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button Content="Save refill" Style="{StaticResource PrimaryButton}" Click="AddPetrolRefill_Click" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <UniformGrid Grid.Row="2" Columns="3">
                        <Border Style="{StaticResource SurfaceCard}" Padding="24" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="DAYS SINCE LAST FILL" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="12"/>
                                <TextBlock x:Name="PetrolDaysSince" Text="--" FontSize="64" FontWeight="Bold" Margin="0,4,0,0"/>
                                <TextBlock x:Name="PetrolLastDate" Text="No refills logged yet" Style="{StaticResource MutedText}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SurfaceCard}" Padding="24" Margin="4,0,4,0"><StackPanel><TextBlock Text="TOTAL REFILLS" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="12"/><TextBlock x:Name="PetrolCount" Text="0" FontSize="64" FontWeight="Bold" Margin="0,4,0,0"/><TextBlock Text="fillings recorded" Style="{StaticResource MutedText}"/></StackPanel></Border>
                        <Border Style="{StaticResource SurfaceCard}" Padding="24" Margin="8,0,0,0"><StackPanel><TextBlock Text="TYPICAL GAP" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="12"/><TextBlock x:Name="PetrolAvgGap" Text="--" FontSize="64" FontWeight="Bold" Margin="0,4,0,0"/><TextBlock Text="days between refills" Style="{StaticResource MutedText}"/></StackPanel></Border>
                    </UniformGrid>

                    <Grid Grid.Row="4" VerticalAlignment="Top">
                        <TextBlock Text="History" Style="{StaticResource SectionTitle}"/>
                        <Button Content="Delete selected refill" HorizontalAlignment="Right" Click="DeletePetrolRefill_Click"/>
                    </Grid>
                    <!-- Date and the gap since the previous fill, nothing else. -->
                    <ListBox x:Name="PetrolHistory" Grid.Row="4" Margin="0,48,0,0" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource PlainListItem}" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                            CornerRadius="10" Padding="18,14" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Border Width="6" Background="{DynamicResource AccentBrush}" CornerRadius="3" Margin="0,2,16,2"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Date}" FontSize="17" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Ordinal}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding GapValue}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}"/>
                                                <TextBlock Text="{Binding GapCaption}" Style="{StaticResource MutedText}" FontSize="11" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                </Grid>

                <Grid x:Name="SettingsPage" Visibility="Collapsed">
                    <TabControl TabStripPlacement="Left" MaxWidth="1120" HorizontalAlignment="Stretch" ItemContainerStyle="{StaticResource SettingsTabItem}">
                        <TabItem Header="General">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource SurfaceCard}" Margin="18,0,0,0" MaxWidth="820"><StackPanel>
                                <TextBlock Text="General and appearance" FontSize="22" FontWeight="Bold"/><TextBlock Text="Choose the Windows presentation without changing the web or TV interface." Style="{StaticResource MutedText}" Margin="0,7,0,18"/>
                                <TextBlock Text="APPEARANCE" Style="{StaticResource KickerText}"/><WrapPanel Margin="0,10,0,18"><Button Content="Dark" Tag="dark" Click="SetTheme_Click" Margin="0,0,8,8"/><Button Content="Light" Tag="light" Click="SetTheme_Click" Margin="0,0,8,8"/><Button Content="OLED black" Tag="oled" Click="SetTheme_Click" Margin="0,0,8,8"/></WrapPanel>
                                <TextBlock Text="LOCAL VAULT" Style="{StaticResource KickerText}"/><TextBlock x:Name="VaultPathText" TextWrapping="Wrap" Margin="0,7,0,14"/><Button Content="Open data folder" Click="OpenVaultFolder_Click" HorizontalAlignment="Left"/>
                                <Separator Margin="0,24"/><TextBlock Text="Keyboard shortcuts" Style="{StaticResource SectionTitle}"/><TextBlock Text="Ctrl+K search · Ctrl+R refresh · Ctrl+, settings · Alt+Left go back · Esc close details" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                            </StackPanel></Border></ScrollViewer>
                        </TabItem>
                        <TabItem Header="Cloud and APIs">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource SurfaceCard}" Margin="18,0,0,0" MaxWidth="820"><StackPanel>
                                <TextBlock Text="Google Drive" FontSize="22" FontWeight="Bold"/><TextBlock Text="Your complete vault is stored as game-vault-backup.json in Google Drive and syncs after every saved change. Create a Desktop OAuth client in Google Cloud Console, enable Google Drive API, then paste its Client ID below. After reinstalling, sign in with the same account to restore the vault." Style="{StaticResource MutedText}" TextWrapping="Wrap" LineHeight="22" Margin="0,7,0,16"/>
                                <TextBlock Text="Google OAuth Client ID" Margin="0,0,0,6"/><TextBox x:Name="DriveClientIdBox" Margin="0,0,0,12"/><TextBlock Text="Client secret (optional)" Margin="0,0,0,6"/><PasswordBox x:Name="DriveClientSecretBox" Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextBrush}" Padding="12,9" Margin="0,0,0,12"/>
                                <TextBlock x:Name="DriveSettingsStatus" Text="Not connected" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,0,6"/><TextBlock x:Name="DriveBackupInfoText" Text="Backup details will appear after connection." Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
                                <WrapPanel><Button Content="Sign in with Google" Style="{StaticResource PrimaryButton}" Click="DriveSignIn_Click" Margin="0,0,8,8"/><Button Content="Sync now" Click="DriveSync_Click" Margin="0,0,8,8"/><Button Content="Disconnect" Click="DriveDisconnect_Click" Margin="0,0,8,8"/></WrapPanel>
                                <Separator Margin="0,24"/><TextBlock Text="Catalog services" Style="{StaticResource SectionTitle}"/><TextBlock Text="RAWG: create a free account at rawg.io/apidocs and copy its key. TMDB: create an account at themoviedb.org, open Settings > API, request a developer key, and use the API Key (v3). OMDb: request a key at omdbapi.com/apikey.aspx and activate it from the email. Keys are encrypted by Windows Credential Manager." Style="{StaticResource MutedText}" TextWrapping="Wrap" LineHeight="22" Margin="0,7,0,14"/>
                                <TextBlock Text="RAWG API key" Margin="0,0,0,6"/><PasswordBox x:Name="RawgKeyBox" Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextBrush}" Padding="12,9" Margin="0,0,0,10"/><TextBlock Text="TMDB API key" Margin="0,0,0,6"/><PasswordBox x:Name="TmdbKeyBox" Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextBrush}" Padding="12,9" Margin="0,0,0,10"/><TextBlock Text="OMDb API key" Margin="0,0,0,6"/><PasswordBox x:Name="OmdbKeyBox" Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextBrush}" Padding="12,9" Margin="0,0,0,12"/><Button Content="Save catalog keys" Style="{StaticResource PrimaryButton}" Click="SaveApiKeys_Click" HorizontalAlignment="Left"/>
                            </StackPanel></Border></ScrollViewer>
                        </TabItem>
                        <TabItem Header="Services">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource SurfaceCard}" Margin="18,0,0,0" MaxWidth="820"><StackPanel>
                                <TextBlock Text="Plex Media Server" FontSize="22" FontWeight="Bold"/><TextBlock Text="Open Plex Web, choose any item > Get Info > View XML, then copy X-Plex-Token from the XML page URL. Paste only the token below. Discover contacts plex.tv with that token, finds your owned server, and fills the best available server URL automatically. Deleting media always requires confirmation." Style="{StaticResource MutedText}" TextWrapping="Wrap" LineHeight="22" Margin="0,7,0,14"/><Button Content="Open official token guide" Click="PlexTokenHelp_Click" HorizontalAlignment="Left" Margin="0,0,0,14"/><TextBlock Text="Plex server URL" Margin="0,0,0,6"/><TextBox x:Name="PlexUrlBox" Margin="0,0,0,10"/><TextBlock Text="X-Plex-Token" Margin="0,0,0,6"/><PasswordBox x:Name="PlexTokenBox" Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextBrush}" Padding="12,9" Margin="0,0,0,12"/><WrapPanel><Button Content="Save Plex settings" Style="{StaticResource PrimaryButton}" Click="SavePlex_Click" Margin="0,0,8,8"/><Button Content="Discover server" Click="DiscoverPlex_Click" Margin="0,0,8,8"/></WrapPanel>
                                <Separator Margin="0,24"/><TextBlock Text="BiglyBT native dashboard" Style="{StaticResource SectionTitle}"/><TextBlock Text="In BiglyBT Web Remote, enable remote access and authentication. Expose it only through your existing HTTPS gateway, then paste that gateway URL below. Enter the same Web Remote username and password; the resulting session is stored in Windows Credential Manager and is device-specific." Style="{StaticResource MutedText}" TextWrapping="Wrap" LineHeight="22" Margin="0,7,0,14"/><TextBlock Text="Secure gateway URL" Margin="0,0,0,6"/><TextBox x:Name="BiglyEndpointBox" Margin="0,0,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Username" Margin="0,0,0,6"/><TextBox x:Name="BiglyUserBox"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Password" Margin="0,0,0,6"/><PasswordBox x:Name="BiglyPasswordBox" Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextBrush}" Padding="12,9"/></StackPanel></Grid><WrapPanel Margin="0,12,0,0"><Button Content="Sign in and save session" Style="{StaticResource PrimaryButton}" Click="BiglySignIn_Click" Margin="0,0,8,8"/><Button Content="Forget session" Click="BiglyDisconnect_Click" Margin="0,0,8,8"/></WrapPanel><CheckBox x:Name="BiglyAutoRemoveBox" Content="Automatically remove completed torrents and keep downloaded files" Margin="0,8,0,0" Checked="BiglyAutoRemove_Changed" Unchecked="BiglyAutoRemove_Changed"/>
                            </StackPanel></Border></ScrollViewer>
                        </TabItem>
                        <TabItem Header="Backup and recovery">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource SurfaceCard}" Margin="18,0,0,0" MaxWidth="820"><StackPanel>
                                <TextBlock Text="Backup and recovery" FontSize="22" FontWeight="Bold"/><TextBlock Text="Atomic saves and local snapshots protect the native vault before imports and edits." Style="{StaticResource MutedText}" Margin="0,7,0,18"/>
                                <WrapPanel><Button Content="Import backup" Style="{StaticResource PrimaryButton}" Click="Import_Click" Margin="0,0,8,8"/><Button Content="Export backup" Click="Export_Click" Margin="0,0,8,8"/><Button Content="Create snapshot" Click="CreateSnapshot_Click" Margin="0,0,8,8"/><Button Content="Open recovery" Click="OpenRecovery_Click" Margin="0,0,8,8"/></WrapPanel>
                                <Separator Margin="0,24"/><TextBlock Text="Diagnostics" Style="{StaticResource SectionTitle}"/><TextBlock Text="The diagnostic export contains app state and errors, never passwords, tokens, library titles, or health records." Style="{StaticResource MutedText}" Margin="0,7,0,14"/><Button Content="Export private diagnostics" Click="ExportDiagnostics_Click" HorizontalAlignment="Left"/>
                            </StackPanel></Border></ScrollViewer>
                        </TabItem>
                        <TabItem Header="About">
                            <Border Style="{StaticResource SurfaceCard}" Margin="18,0,0,0" MaxWidth="820" VerticalAlignment="Top"><StackPanel>
                                <TextBlock Text="Sinu Game Vault for Windows" FontSize="24" FontWeight="Bold"/><TextBlock x:Name="AppVersionText" Text="Native Windows edition" Foreground="{DynamicResource AccentBrush}" Margin="0,6,0,18"/><TextBlock Text="The complete vault automatically syncs to Google Drive after every saved change. After reinstalling, sign in with the same Google account to restore your library." TextWrapping="Wrap" LineHeight="23"/><Button Content="Check GitHub for updates" Margin="0,22,0,0" HorizontalAlignment="Left" Click="CheckUpdates_Click"/>
                            </StackPanel></Border>
                        </TabItem>
                    </TabControl>
                </Grid>

                <StackPanel x:Name="LibraryEmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400">
                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="36" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,18"/>
                    <TextBlock Text="No titles to show" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Find a title to add, or clear your current filters." TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,20"/>
                    <Button x:Name="LibraryEmptyAction" Content="Find a title" Click="LibraryEmpty_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center"/>
                </StackPanel>
                <Border x:Name="DetailsPage" Visibility="Collapsed" Background="{DynamicResource WindowBrush}" Panel.ZIndex="20">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,14">
                            <Button Click="CloseDetails_Click" ToolTip="Back to library (Esc)" AutomationProperties.Name="Back to library" Width="44" Padding="0" DockPanel.Dock="Left" Margin="0,0,12,0"><TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="18"/></Button>
                            <Button Click="CloseDetails_Click" ToolTip="Close title" AutomationProperties.Name="Close title" Width="44" Padding="0" DockPanel.Dock="Right"><TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="16"/></Button>
                            <TextBlock Text="Title details" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ScrollViewer x:Name="DetailScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                            <StackPanel Margin="0,0,16,28">
                                <Grid MinHeight="280">
                                    <Image x:Name="DetailBackdrop" Stretch="UniformToFill" Opacity="0.22" IsHitTestVisible="False"/>
                                    <Border Background="{DynamicResource BackdropScrimBrush}" IsHitTestVisible="False"/>
                                    <Grid Margin="24">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Border x:Name="DetailPosterFrame" Width="220" Height="330" Background="{DynamicResource PanelRaisedBrush}" CornerRadius="8" ClipToBounds="True" VerticalAlignment="Top">
                                            <Grid><TextBlock Text="GV" FontSize="48" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="DetailPoster" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/></Grid>
                                        </Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock x:Name="DetailType" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBox x:Name="DetailTitle" Style="{StaticResource SelectableText}" FontSize="34" FontWeight="SemiBold" Margin="0,10,0,12"/>
                                            <TextBox x:Name="DetailMeta" Style="{StaticResource SelectableMutedText}" FontSize="15"/>
                                            <WrapPanel Margin="0,18,0,0">
                                                <TextBlock x:Name="DetailRating" Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold" FontSize="17" Margin="0,0,20,10"/>
                                                <TextBlock x:Name="DetailCountdown" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="24" Margin="0,0,20,10"/>
                                                <Border x:Name="DetailEpisodesBadge"><TextBlock x:Name="DetailEpisodes" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10"/></Border>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                                <WrapPanel Margin="0,20,0,18">
                                    <Button x:Name="DetailMoveButton" Content="Start watching" Style="{StaticResource PrimaryButton}" Click="MoveStatus_Click" Margin="0,0,8,8"/>
                                    <Button Content="Watch trailer" Click="Trailer_Click" Margin="0,0,8,8"/>
                                    <Button Content="Change status" Click="ChangeStatus_Click" Margin="0,0,8,8"/>
                                    <Button Content="Edit details" Click="EditSelected_Click" Margin="0,0,8,8"/>
                                    <Button x:Name="DetailRemoveButton" Content="Remove" Foreground="{DynamicResource DangerBrush}" Click="RemoveDetail_Click" Margin="0,0,8,8"/>
                                </WrapPanel>
                                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"/>
                                <StackPanel Margin="0,20,0,0">
                                    <TextBlock Text="Overview" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,14"/>
                                    <StackPanel x:Name="DetailSynopsisSection" Visibility="Collapsed"><TextBox x:Name="DetailSynopsis" Style="{StaticResource SelectableText}" FontSize="17" MaxWidth="920" HorizontalAlignment="Left"/></StackPanel>
                                    <TextBlock Text="Availability" FontSize="17" FontWeight="SemiBold" Margin="0,20,0,8"/>
                                    <TextBox x:Name="DetailAvailability" Style="{StaticResource SelectableMutedText}" FontSize="15"/>
                                    <WrapPanel Margin="0,14,0,0">
                                        <Button x:Name="VendorLinksButton" Content="Rental vendors" Click="VendorLinks_Click" Margin="0,0,8,8"/>
                                        <Button x:Name="VendorRefreshButton" Content="Refresh vendors" Click="VendorRefresh_Click" Margin="0,0,8,8"/>
                                    </WrapPanel>
                                    <Border x:Name="DetailStorySection" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,20" Margin="0,12,0,0">
                                        <StackPanel><DockPanel Margin="0,0,0,14"><Button x:Name="RefreshPlotButton" Content="Refresh plot" Click="RefreshPlot_Click" DockPanel.Dock="Right" HorizontalAlignment="Right"/><TextBlock Text="Story and plot" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><TextBox x:Name="DetailOverview" Style="{StaticResource SelectableText}" FontSize="17" MaxWidth="920" HorizontalAlignment="Left"/></StackPanel>
                                    </Border>
                                    <StackPanel x:Name="EpisodePicker" Visibility="Collapsed" Margin="0,18,0,0">
                                        <TextBlock Text="Episodes" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,14"/>
                                        <WrapPanel><StackPanel Margin="0,0,12,12"><TextBlock Text="Season" Margin="0,0,0,6" Foreground="{DynamicResource MutedBrush}"/><ComboBox x:Name="DetailSeasonBox" Width="110" SelectionChanged="DetailSeason_Changed"/></StackPanel><StackPanel Margin="0,0,12,12"><TextBlock Text="Episode" Margin="0,0,0,6" Foreground="{DynamicResource MutedBrush}"/><ComboBox x:Name="DetailEpisodeBox" Width="340" SelectionChanged="DetailEpisode_Changed"/></StackPanel><Button Content="Load episode story" VerticalAlignment="Bottom" Margin="0,0,0,12" Click="EpisodePlot_Click"/></WrapPanel>
                                    </StackPanel>
                                    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,20">
                                        <StackPanel><TextBlock Text="Your activity" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,14"/><TextBox x:Name="DetailNote" Style="{StaticResource SelectableMutedText}" FontSize="15"/>
                                            <WrapPanel Margin="0,12,0,0"><TextBlock Text="My rating" VerticalAlignment="Center" Margin="0,0,12,0"/><ComboBox x:Name="PersonalRatingBox" Width="120"><ComboBoxItem Content="Not rated" Tag="0"/><ComboBoxItem Content="1 / 10" Tag="1"/><ComboBoxItem Content="2 / 10" Tag="2"/><ComboBoxItem Content="3 / 10" Tag="3"/><ComboBoxItem Content="4 / 10" Tag="4"/><ComboBoxItem Content="5 / 10" Tag="5"/><ComboBoxItem Content="6 / 10" Tag="6"/><ComboBoxItem Content="7 / 10" Tag="7"/><ComboBoxItem Content="8 / 10" Tag="8"/><ComboBoxItem Content="9 / 10" Tag="9"/><ComboBoxItem Content="10 / 10" Tag="10"/></ComboBox><Button Content="Save rating" Margin="8,0,0,0" Click="SaveRating_Click"/></WrapPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,20">
                                        <StackPanel><TextBlock Text="Reviews and links" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,14"/>
                                            <WrapPanel><Button Content="IMDb" Click="Imdb_Click" Margin="0,0,8,8"/><Button Content="Wikipedia" Click="Wikipedia_Click" Margin="0,0,8,8"/><Button Content="Google search" Click="Google_Click" Margin="0,0,8,8"/><Button Content="IGN review" Click="IgnReview_Click" Margin="0,0,8,8"/><Button Content="Reeload Media review" Click="ReeloadReview_Click" Margin="0,0,8,8"/><Button x:Name="FandomButton" Content="Fandom" Click="Fandom_Click" Margin="0,0,8,8"/><Button Content="AI assistant" Click="AiAssistant_Click" Margin="0,0,8,8"/></WrapPanel>
                                            <WrapPanel x:Name="MalayalamReviewButtons" Visibility="Collapsed"><Button Content="Monsoon Media review" Click="MonsoonReview_Click" Margin="0,0,8,8"/><Button Content="Aswanth Kok review" Click="AswanthReview_Click" Margin="0,0,8,8"/></WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" Background="{DynamicResource RailBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="28,0">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="StatusText" Text="Ready" Style="{StaticResource MutedText}" VerticalAlignment="Center"/><Button x:Name="UndoButton" Content="Undo" Style="{StaticResource QuietButton}" Padding="10,3" MinHeight="26" Margin="12,0,0,0" Visibility="Collapsed" Click="Undo_Click"/></StackPanel><ProgressBar x:Name="GlobalProgress" Grid.Column="1" Height="4" Margin="16,0" IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="Sinu Game Vault for Windows" Style="{StaticResource MutedText}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
