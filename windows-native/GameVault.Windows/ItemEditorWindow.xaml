<Window x:Class="SinuGameVault.ItemEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit library item" Width="720" Height="760" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="Heading" Text="Library item" FontSize="26" FontWeight="Bold"/>
            <TextBlock x:Name="Description" Text="All changes are saved to the same Drive-synced GameVault record." Style="{StaticResource MutedText}" Margin="0,5,0,18"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,0,12,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,14"><TextBlock Text="Title" Margin="0,0,0,6"/><TextBox x:Name="NameBox"/></StackPanel>
                <StackPanel Grid.Row="1" Margin="0,0,0,14"><TextBlock Text="Status" Margin="0,0,0,6"/><ComboBox x:Name="StatusBox"><ComboBoxItem Content="Playing"/><ComboBoxItem Content="Resume Later"/><ComboBoxItem Content="On Hold"/><ComboBoxItem Content="Finished"/><ComboBoxItem Content="Dropped"/><ComboBoxItem Content="Watching"/><ComboBoxItem Content="Watched"/></ComboBox></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,14"><TextBlock Text="Platform / service" Margin="0,0,0,6"/><TextBox x:Name="PlatformBox"/></StackPanel>
                <StackPanel Grid.Row="2" Margin="0,0,0,14"><TextBlock Text="Start / release date" Margin="0,0,0,6"/><DatePicker x:Name="StartDateBox"/></StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,14"><TextBlock Text="Return / end date" Margin="0,0,0,6"/><DatePicker x:Name="EndDateBox"/></StackPanel>
                <StackPanel Grid.Row="3" Margin="0,0,0,14"><TextBlock Text="Vendor / provider" Margin="0,0,0,6"/><TextBox x:Name="VendorBox"/></StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,14"><TextBlock Text="Cost" Margin="0,0,0,6"/><TextBox x:Name="CostBox"/></StackPanel>
                <StackPanel Grid.Row="4" Margin="0,0,0,14"><TextBlock Text="Your rating (0-10)" Margin="0,0,0,6"/><TextBox x:Name="RatingBox"/></StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,0,0,14"><TextBlock Text="Genre" Margin="0,0,0,6"/><TextBox x:Name="GenreBox"/></StackPanel>
                <StackPanel Grid.Row="5" Grid.ColumnSpan="3" Margin="0,0,0,14"><TextBlock Text="Cover image URL" Margin="0,0,0,6"/><TextBox x:Name="ImageBox"/></StackPanel>
                <StackPanel Grid.Row="6" Grid.ColumnSpan="3" Margin="0,0,0,14"><TextBlock Text="Plot / summary" Margin="0,0,0,6"/><TextBox x:Name="OverviewBox" Height="100" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></StackPanel>
                <StackPanel Grid.Row="7" Grid.ColumnSpan="3"><TextBlock Text="Remarks" Margin="0,0,0,6"/><TextBox x:Name="NoteBox" Height="74" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></StackPanel>
            </Grid>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Width="100" IsCancel="True" Margin="0,0,10,0"/>
            <Button x:Name="SaveButton" Content="Save" Width="120" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
