<Window x:Class="SinuGameVault.HealthTargetsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Weekly health targets" Width="560" Height="590" WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}">
    <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Weekly health targets" FontSize="25" FontWeight="Bold"/>
        <UniformGrid Grid.Row="1" Columns="2" Margin="0,20,0,0">
            <StackPanel Margin="0,0,10,12"><TextBlock Text="Plant meals"/><TextBox x:Name="PlantBox" Margin="0,6,0,0"/></StackPanel><StackPanel Margin="10,0,0,12"><TextBlock Text="Fish meals"/><TextBox x:Name="FishBox" Margin="0,6,0,0"/></StackPanel>
            <StackPanel Margin="0,0,10,12"><TextBlock Text="Red meat max"/><TextBox x:Name="RedBox" Margin="0,6,0,0"/></StackPanel><StackPanel Margin="10,0,0,12"><TextBlock Text="Fried meals max"/><TextBox x:Name="FriedBox" Margin="0,6,0,0"/></StackPanel>
            <StackPanel Margin="0,0,10,12"><TextBlock Text="Fruit servings"/><TextBox x:Name="FruitBox" Margin="0,6,0,0"/></StackPanel><StackPanel Margin="10,0,0,12"><TextBlock Text="Vegetable servings"/><TextBox x:Name="VegBox" Margin="0,6,0,0"/></StackPanel>
            <StackPanel Margin="0,0,10,12"><TextBlock Text="Activity minutes"/><TextBox x:Name="ActivityBox" Margin="0,6,0,0"/></StackPanel><StackPanel Margin="10,0,0,12"><TextBlock Text="Strength days"/><TextBox x:Name="StrengthBox" Margin="0,6,0,0"/></StackPanel>
        </UniformGrid><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Width="100" IsCancel="True" Margin="0,0,10,0"/><Button Content="Save targets" Width="130" Style="{StaticResource PrimaryButton}" Click="Save_Click"/></StackPanel>
    </Grid>
</Window>
