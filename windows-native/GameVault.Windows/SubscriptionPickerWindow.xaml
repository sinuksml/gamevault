<Window x:Class="SinuGameVault.SubscriptionPickerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose subscription" Width="480" Height="250" MinWidth="460" MinHeight="240" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24"><TextBlock Text="Available through" FontSize="21" FontWeight="Bold"/><TextBlock Text="Choose the service that provides this game." Style="{StaticResource MutedText}" Margin="0,5,0,16"/><ComboBox x:Name="SubscriptionBox"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0"/><Button Content="Add game" Style="{StaticResource PrimaryButton}" Click="Add_Click"/></StackPanel></StackPanel>
</Window>
