<Window x:Class="SinuGameVault.CatalogSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:SinuGameVault.Services"
        Title="Find online" Width="860" Height="640" WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel><TextBox x:Name="QueryBox" MinWidth="560" Margin="0,0,10,0" KeyDown="Query_KeyDown"/><Button Content="Search" Style="{StaticResource PrimaryButton}" Click="Search_Click"/></DockPanel>
        <DataGrid x:Name="ResultsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="Results_DoubleClick">
            <DataGrid.Columns><DataGridTemplateColumn Header="" Width="80"><DataGridTemplateColumn.CellTemplate><DataTemplate><Image app:Artwork.Url="{Binding Image}" Width="64" Height="64" Stretch="Uniform" Margin="4"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="130"/><DataGridTextColumn Header="Rating" Binding="{Binding Rating}" Width="80"/><DataGridTextColumn Header="Genre" Binding="{Binding Genre}" Width="150"/></DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="3" Margin="0,16,0,0"><TextBlock x:Name="StatusText" Text="Search the live catalog." Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Width="100" IsCancel="True" Margin="0,0,10,0"/><Button Content="Add selected" Width="130" Style="{StaticResource PrimaryButton}" Click="Add_Click"/></StackPanel></DockPanel>
        <Button Grid.Row="4" Content="Enter title manually" Click="Manual_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/>
    </Grid>
</Window>
